          <msContents>
            <summary>Commentary on Maḥmūd ibn Muḥammad Jaghmīnī's Al-mulakhkhaṣ fī al-hayʾah by Mūsá
              ibn Muḥammad Qāḍīʹzādah. This copy contains both the commentary and the Jaghmīnī's
              text.</summary>

            <msItem xml:id="manuscript_14053-item1">
              <title xml:lang="ar-Latn-x-lc" key="work_371">Sharḥ al-mulakhkhaṣ fī al-hayʿah
                al-basīṭah</title>
              <title xml:lang="ar" type="alt">شرح الملخص في الهيئة البسيطة</title>
              <author key="person_73701246"><persName xml:lang="en">Qāḍīʾzādah, Mūsá ibn Muḥammad,
                  -approximately 1436</persName> (<persName xml:lang="ar">موسى بن محمود قاضي زاده
                  الرومي</persName>)</author>
              <textLang mainLang="ar">Arabic</textLang>
              <note><p>Commentary on The epitome concerning the configuration of the Heavens, a
                  compendium on astronomy written by Maḥmūd ibn Muḥammad Jaghmīnī.</p>
              </note>
            </msItem>
            <msItem xml:id="manuscript_14053-item2">
              <title xml:lang="ar-Latn-x-lc" key="work_2801">Al-mulakhkhaṣ fī al-hayʿah
                al-basīṭah</title>
              <title xml:lang="ar" type="alt">الملخص في الهيئة البسيطة</title>
              <author key="person_5146153029805251752"><persName>Maḥmūd ibn Muḥammad
                  Jaghmīnī</persName> (<persName>محمود بن محمد بن عمر الخوارزمي
                الحغميني</persName>)</author>
              <textLang mainLang="ar">Arabic</textLang>
              <note>
                <p>The text commented upon is written in red and embodied with the
                commentary.</p></note>
            </msItem>

          </msContents>

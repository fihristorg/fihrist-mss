               <msContents>
                  <summary change="#add-summary"> Shāhnāmah by Firdawsī </summary>
                  <msItem xml:id="Persian_MS_933-item1">
                     <author key="person_101359236" ref="http://viaf.org/viaf/101359236/">
                        <persName xml:lang="fa-Latn-x-lc" type="standard">Firdawsī</persName>
                        <persName xml:lang="fa">فردوسي</persName>
                     </author>
                     <title xml:lang="fa-Latn-x-lc" key="work_2149" change="#ids-cleanup"
                        >Shāhnāmah</title>
                     <title xml:lang="fa" key="work_2149" change="#ids-cleanup">شاهنامه</title>
                     <incipit xml:lang="fa" type="basmala"><locus from="1b" to="1b"> برگ ۱پ (folio
                           1b):</locus> بسم‌الله الرحمن الرحیم * هست کلید در گنج حکیم | فاتحه فکرت و
                        ختم سخن * نام خدایست بر او ختم کن | سابقه سالار جهان قدم * مرسله پیوند گلوی
                        قلم نام خدایست بر او ختم کن</incipit>
                     <explicit xml:lang="fa">
                        <locus from="233a" to="233a"> برگ ۲۳۳ر (folio 233a):</locus> کو هیج ذکر
                        مناثین(؟) چون مست غمت * چون هست غمت ذکر چه غم دارم من. </explicit>
                     <colophon xml:lang="fa"> تم بالخیر کتبه العبد الفقیر محمد کاتب اللاری سنة ثمان
                        وثلاثين وتسعماية</colophon>

                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc material="chart">
                        <support>Textblock of cross-grained, externally sized and polished,
                           ivory-coloured <material>paper</material> probably handmade in the
                              <placeName cert="high" ref="http://vocab.getty.edu/page/tgn/7000208"
                              key="place_7000208">Indian subcontinent</placeName> with ~8 laid lines
                           per cm and no discernible chain lines.</support>
                        <extent>
                           <measure unit="folio" quantity="266">266 folios, 4 flyleaves (ff. ii +
                              266 + ii)</measure>. <dimensions type="leaf" unit="mm">
                              <height>385</height>
                              <width>283</width>
                           </dimensions>
                           <dimensions type="written" unit="mm">
                              <height>267</height>
                              <width>197</width>
                           </dimensions>
                        </extent>
                        <foliation xml:id="modern">Modern pencilled Arabic numerals added to the
                           upper-left corners of the a sides.</foliation>

                        <collation> Undetermined. <catchwords>Catchwords throughout most of the
                              lower-left corners of the b sides.</catchwords></collation>


                        <condition>In fair condition, with moderate water and insect damage,
                           historical repairs, and repainted and re-written areas
                           throughout.</condition>
                     </supportDesc>


                     <layoutDesc>
                        <layout columns="1 6" ruledLines="31" n="mistara"> Written in 1 to 6 columns
                           with 31 lines per page. Ruled with a <hi rend="italic">misṭarah</hi> hand
                           guide.</layout>
                     </layoutDesc>
                  </objectDesc>
                  <handDesc>
                     <handNote scope="major" script="nasta_liq" medium="ink"> Written in clear
                           <material>black</material> nasta‘līq with <material>gold</material>
                        subheaders. </handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote type="headpiece"><label>Illumination:</label> Folio <locus from="1b"
                           to="1b">1b</locus> bears a scalloped domed headpiece with gilt palmette
                        foliate scrollwork on an ultramarine ground and an uninscribed central
                        cartouche, and four vertical radiating lines.</decoNote>
                     <decoNote type="marginal"><label>Ruling:</label> Folios <locus from="1b"
                           to="2a>">1b and 2a</locus> ruled in <material>gold</material> outlined
                        with thin black lines, and surrounded by another single line. The margins of
                        folios <locus from="2b">2b</locus> onwards ruled with single lines of
                        ultramarine blue.</decoNote>
                  </decoDesc>
                  <additions>
                     <lb/>
                     <label>Inscriptions:</label>
                     <list>
                        <item/>
                        <item> The <locus from="ia" to="ia">right flyleaf a side (f. ia)</locus>
                           bears . </item>
                        <item>Folios <locus from="10a" to="10b">10a and b</locus> inscribed with
                           .</item>
                     </list>
                     <label>Bookplates:</label> The <locus from="Inner_back_cover"
                        to="Inner_back_cover">left pastedown</locus>: <q xml:lang="en">Bibliotheca
                        Lindesiana</q> with pencilled shelfmark <q xml:lang="en">F/3</q>, and <q
                        xml:lang="en">Persian MSS Nº 933</q>. </additions>
                  <bindingDesc>
                     <binding notBefore="1700" notAfter="1800">
                        <p>Probably originally bound in the <placeName cert="high"
                              ref="http://vocab.getty.edu/page/tgn/7000208" key="place_7000208"
                              >Indian subcontinent</placeName> in the 18th century, then susequently
                           restored in Britain for <persName type="standard"
                              ref="http://viaf.org/viaf/97751058/" key="person_97751058" role="fmo"
                              change="#role-assignment">Alexander Lindsay</persName>. </p>
                        <p>Heavy wove endpapers added to the beginning and end. Resewn on three
                           recessed cord supports, but not laced into pasteboards. Edges trimmed,
                           spattered blue, and pre-manufactured headbands adhered at <locus
                              from="Head" to="Head">head</locus> and <locus from="Tail" to="Tail"
                              >tail</locus>. </p>
                        <decoNote type="binding"/>
                        <p><dimensions type="binding" unit="mm">
                              <height>407</height>
                              <width>298</width>
                              <depth>48</depth>
                           </dimensions></p>
                        <condition>Handle binding with caution. In fair but stable condition, with
                           extensive abrasion to the exterior, onlay loss and damage, bumped corners
                           and headcaps. Boxed.</condition>
                     </binding>
                  </bindingDesc>
                  <sealDesc>
                     <summary/>
                     <seal type="stamp" subtype="rectangle">
                        <p><label>1:</label> Folio <locus from="2b" to="2b">2b</locus> a rectangular
                           seal impression in four nasta‘līq lines bearing the name of former owner
                           <persName/></p>
                     </seal>
                  </sealDesc>
               </physDesc>
               <history>
                  <origin><origDate calendar="#Hijri-qamari" when="1780">1195 AH (1780
                        CE)</origDate></origin>

                  <provenance><p>Subsequently bought by <persName>G. A. Nichetti</persName> who
                        brought the volume back to Italy</p></provenance>
                  <provenance><p>Purchased from Nichetti by <persName type="standard"
                           ref="http://viaf.org/viaf/97751058/" key="person_97751058" role="fmo"
                           change="#role-assignment">Alexander Lindsay, 25th Earl of
                           Crawford</persName> and then moved to <orgName
                           ref="http://viaf.org/viaf/295427552" key="person_295427552">Bibliotheca
                           Lindesiana</orgName> at Haigh Hall, <placeName
                           ref="http://vocab.getty.edu/page/tgn/7010384" key="place_7010384"
                           >Wigan</placeName>. </p></provenance>
                  <provenance><p>Purchased by <persName role="dnr" key="person_f6379"
                           change="#prov-markup">Enriqueta Rylands (1843–1908)</persName> in <date
                           calendar="#Gregorian" when="1901">1901</date> from <persName role="fmo"
                           ref="http://viaf.org/viaf/9985420/" key="person_9985420">James Ludovic
                           Lindsay, 26th Earl of Crawford (1847–1913)</persName>.</p></provenance>
                  <acquisition>
                     <p>Bequeathed by <persName key="person_f6379" change="#prov-markup">Enriqueta
                           Rylands (1843–1908)</persName> in <date calendar="#Gregorian" when="1908"
                           >1908</date> to the <orgName type="corporation" role="rps"
                           ref="http://viaf.org/viaf/312795145/">John Rylands Library</orgName>,
                           <placeName ref="http://vocab.getty.edu/page/tgn/7010477"
                           key="place_7010477">Manchester</placeName>.</p>
                  </acquisition>
               </history>
               <additional>
                  <adminInfo>

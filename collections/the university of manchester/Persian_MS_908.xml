                    <msContents>
                        <summary> Illustrated copy of the <title>Kullīyāt</title> (Collected Works)
                            of ʻUrfī Shīrāzī.</summary>
                        <msItem xml:id="Persian_MS_908-item1">
                            <author key="person_50413291" ref="http://viaf.org/viaf/50413291/">
                                <persName xml:lang="fa-Latn-x-lc" type="standard">ʻUrfī Shīrāzī,
                                    Muḥammad, 1555 or 6-1590 or 91</persName>
                                <persName xml:lang="fa">عرفى</persName>
                            </author>
                            <title xml:lang="ar-Latn-x-lc" key="work_20212" change="#ids-cleanup"
                                >Kullīyāt</title>
                            <title xml:lang="fa" key="work_20212" change="#ids-cleanup"
                                >كليات</title>
                            <textLang mainLang="fa">Persian</textLang>

                            <note>For other copies of works by this author held in the Rylands, see <ref
                                    target="https://www.fihrist.org.uk/catalog/manuscript_6781"><idno>Persian
                                        MS 291</idno></ref>, <ref
                                            target="https://www.fihrist.org.uk/catalog/manuscript_6782">292</ref>,
                                <ref target="https://www.fihrist.org.uk/catalog/manuscript_6783"
                                    >293</ref>, <ref
                                        target="https://www.fihrist.org.uk/catalog/manuscript_6784">294</ref>,
                                <ref target="https://www.fihrist.org.uk/catalog/manuscript_7045"
                                    >549</ref>, <ref
                                        target="https://www.fihrist.org.uk/catalog/manuscript_7071">573</ref>,
                                and <ref target="https://www.fihrist.org.uk/catalog/manuscript_7374"
                                    >863</ref>.</note>                        </msItem>
                    </msContents>
                    <physDesc>
                        <objectDesc form="codex">
                            <supportDesc material="chart">
                                <support>Cross-grained ivory-coloured paper probably handmade in
                                        <placeName cert="high"
                                        ref="http://vocab.getty.edu/page/tgn/7000235"
                                        key="place_7000235">Greater Iran</placeName>, with ~9 laid
                                    line per cm and no discernible chain lines.</support>
                                <extent> 271 folios <dimensions type="leaf" unit="mm">
                                        <height>222</height>
                                        <width>123</width>
                                    </dimensions>
                                    <dimensions type="written" unit="mm">
                                        <height>130</height>
                                        <width>60</width>
                                    </dimensions>
                                </extent>
                            </supportDesc>
                            <layoutDesc>
                                <layout columns="1 4" ruledLines="17" n="mistara"> Written in 1 to 4
                                    columns with 17 lines per page. Ruled with a <hi rend="italic"
                                        >misṭarah</hi> hand guide.</layout>
                            </layoutDesc>

                        </objectDesc>
                        <handDesc>
                            <handNote scope="major" script="nasta_liq" medium="ink"> Written in
                                clear <material>black</material> nasta‘līq with subheaders in
                                    <material>white</material>. </handNote>
                        </handDesc>
                        <decoDesc>
                            <decoNote type="illustration"> Two double page miniatures at the
                                beginning (<locus from="1b" to="1b">1b</locus> and <locus from="2a"
                                    to="2a">2a</locus>) and end (<locus from="270b" to="270b"
                                    >270b</locus> and <locus from="271a" to="271a">271a</locus>),
                                both enclosed in richly illuminated borders. </decoNote>
                            <decoNote type="decoration">Illuminated headings with richly decorated
                                margins on folios <locus from="2b" to="2b">2b</locus> (Preface),
                                    <locus from="66b" to="66b">66b</locus> (Qasidas), <locus
                                    from="131b" to="131b">131b</locus> (Short Poems), <locus
                                    from="141b" to="141b">141b</locus> (Ghazals) and <locus
                                    from="253b" to="253b">253b</locus> (Quatrains).</decoNote>
                        </decoDesc>
                        <bindingDesc>
                            <binding notBefore="1628" notAfter="1700">
                                <decoNote>Contemporary binding very similar to that of Persian MS 35
                                    (the gilt panels on the outer faces are from the same die) and
                                    no doubt from the same workshop, with panels of inscription of
                                    cut-out and inlaid coloured leather and cut-out work on the
                                    doublures.</decoNote>

                                <!--  <p><dimensions type="binding" unit="mm">
                                <height></height>
                                <width></width>
                                <depth></depth>
                            </dimensions></p> 
                            <condition></condition>-->
                            </binding>
                        </bindingDesc>
                        <accMat>Modern red leather slip-case. Note inserted at the back describes
                            the acquisition in <placeName>Lisbon</placeName> in <date
                                calendar="#Gregorian" when="1883">1883</date> for £80.</accMat>

                    </physDesc>
                    <history>
                        <origin>Completed by <persName role="scr" key="person_f5941">Muhammad Husayn
                                Dar-al-Marzi</persName> known as <addName type="honorific"
                                key="person_f5941">Qāz̤ī</addName>, probably in <origPlace
                                cert="medium" ref="http://vocab.getty.edu/page/tgn/7017459"
                                key="place_7023981">Isfahan</origPlace>
                            <origDate calendar="#Hijri-qamari" when="1628-12-05">Tuesday, 8 Rabi' II
                                1038 (5 Dec. 1628 CE)</origDate>. </origin>
                        <provenance>
                            <p>Obtained by French orientalist <persName
                                    type="standard" ref="http://viaf.org/viaf/51695910"
                                    key="person_51695910" role="fmo" change="#role-assignment"
                                    >Antoine-Isaac Silvestre de Sacy (1758-1838)</persName> from an unidentified source.</p></provenance>
                        <provenance><p>Possibly acquired at the de Sacy sale by <persName key="person_f6689"
                                    role="fmo" change="#prov-markup">Chevalier J. Ferrão de
                                    Castel-Branco (or Castelbranco)</persName> who makes a single
                                appearance in 1847 as a member of the Royal Asiatic Society. </p></provenance>
                        <provenance> <p>A note on a slip inserted in the manuscript reads 'Purchased in May
                                1883 at an orientalist sale in Lisbon for £80' by <persName role="fmo"
                                    ref="http://viaf.org/viaf/9985420/" key="person_9985420">James Ludovic
                                    Lindsay, 26th Earl of Crawford (1847–1913)</persName>.</p>
                        </provenance>
                        <provenance><p>Purchased by <persName role="dnr" key="person_f6379"
                                    change="#prov-markup">Enriqueta Rylands (1843–1908)</persName> in <date
                                        calendar="#Gregorian" when="1901">1901</date> from <persName role="fmo"
                                            ref="http://viaf.org/viaf/9985420/" key="person_9985420">James Ludovic
                                            Lindsay, 26th Earl of Crawford (1847–1913)</persName>.</p></provenance>
                        <acquisition>
                            <p>Bequeathed by <persName key="person_f6379" change="#prov-markup">Enriqueta
                                    Rylands (1843–1908)</persName> in <date calendar="#Gregorian" when="1908"
                                        >1908</date> to the <orgName type="corporation" role="rps"
                                            ref="http://viaf.org/viaf/312795145/">John Rylands Library</orgName>,
                                <placeName ref="http://vocab.getty.edu/page/tgn/7010477"
                                    key="place_7010477">Manchester</placeName>.</p>
                        </acquisition>
                    </history>

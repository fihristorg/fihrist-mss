                                    <width>141</width>
                                </dimensions>
                                <dimensions type="illustration" unit="mm">
                                    <height>175</height>
                                    <width>127</width>
                                </dimensions>
                            </decoNote>
                            <note>These external stencilled margins also appear in the "small" Lord

                            <textLang mainLang="fa">Persian</textLang>
                            <decoNote>
                                <dimensions type="margin" unit="mm">
                                    <height>337</height>
                                    <width>214</width>
                                </dimensions>
                                <dimensions type="gilt_margin" unit="mm">

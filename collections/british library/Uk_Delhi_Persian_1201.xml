        <msDesc xml:id="Uk_Delhi_Persian_1201" xml:lang="en">
          <msIdentifier>
            <country>United Kingdom</country>
            <settlement>London</settlement>
            <institution>British Library</institution>
            <repository>Oriental Manuscripts</repository>
            <collection>India Office Library</collection>
            <idno>Delhi Persian 1201</idno>
            <altIdentifier type="former">
              <idno>P 882</idno>
            </altIdentifier>
            <altIdentifier type="former">
              <idno>1892</idno>
              <note>ʻatīq</note>
            </altIdentifier>
          </msIdentifier>
          <head>Majmūʻah (a, b)</head>
          <msContents>
            <summary>A composite volume containing two separate Persian manuscripts (a)
                <title>Taʻbīr'nāmah</title> and (b) <title>Dah majlis</title></summary>
            <textLang mainLang="per">Persian</textLang>
          </msContents>
          <physDesc>
            <objectDesc form="codex">
              <supportDesc material="chart">
                <extent>ff. 78 + wrapper<dimensions type="leaf" unit="mm">
                    <height>220</height>
                    <width>125</width>
                  </dimensions>
                </extent>
                <foliation>
                  <p>India Office stamped foliation.</p>
                </foliation>
                <condition>
                  <p>The manuscript is unbound and is enclosed within a torn wrapper made from
                    reused office paper. </p>
                </condition>
              </supportDesc>
            </objectDesc>
            <sealDesc>
              <seal subtype="oval" type="stamp">
                <p>Black Government of India Delhi MSS oval stamp (ff. 1r, 24r, 78v).</p>
              </seal>
            </sealDesc>
            <accMat>
              <p>Wrapper: Reused office paper, watermarked 1816. </p>
            </accMat>
          </physDesc>
          <history>
            <origin notBefore="1700" notAfter="1799">18th century; <origPlace>India</origPlace>
            </origin>
            <provenance>
              <p>Both items were purchased by and belonged to <persName role="fmo"
                  key="person_f7378">Muḥammad Karīm Allāh. </persName>. </p>
              <p>Purchased by the Government of India at a sale organised by the Delhi Prize Agents
                in 1859. </p>
            </provenance>
            <acquisition>
              <p>Acquired by the India Office Library as an administrative deposit in
                  <date>1876</date>. </p>
            </acquisition>
          </history>
          <additional>
            <adminInfo>
              <recordHist>
                <source>
                  <p>Based on<persName type="standard" key="viaf_73981096" role="cataloguer">R.
                      Levy</persName>'s description in<title>Drafts for Catalogue of Persian
                      Manuscripts in the India Office Library, vol. III</title>. Revised with the
                    manuscript in hand by <persName role="cataloguer">Sheida
                      Heydarishovir.</persName>.</p>
                </source>
              </recordHist>
              <availability status="free">
                <p>Entry to read in the Library is permitted only on presentation of a valid
                  reader's card for admissions procedures contact<ref
                    target="http://www.bl.uk/visit/reader-pass/" type="n/a">British Library,
                    Registering for a Reader Pass</ref>.</p>
              </availability>
            </adminInfo>
          </additional>
          <msPart xml:id="Uk_Delhi_Persian_1201-part1">
            <msIdentifier>
              <altIdentifier type="partial">
                <idno>Delhi Persian 1201a</idno>
              </altIdentifier>
            </msIdentifier>
            <msContents class="http://id.loc.gov/authorities/subjects/sh92004927">
              <summary>A short mas̲navī composition dealing with the interpretation of dreams, by an
                author whose name does not appear</summary>
              <msItem xml:id="Uk_Delhi_Persian_1201-part1-item1">
                <locus from="1v" to="13r">ff. 1r-13r</locus>
                <title xml:lang="fa-Latn-x-lc" key="work_23858">Taʻbīr'nāmah</title>
                <title xml:lang="fa" key="">تعبیر نامه</title>
                <textLang mainLang="fa">Persian</textLang>
                <incipit xml:lang="fa">معبر گفت در تعبیر خوش راز / گرت باید شنو تا گویمت
                  باز</incipit>
                <explicit xml:lang="fa">اگر قندیل برافروخت میدان/ که عادلتر شود قاضی و
                  سلطان</explicit>
                <colophon xml:lang="fa">تمت تمام شد کار من نظام شد/ در جواب چو رو تو بدیدم/ رحمت حق
                  نثار خوانندده بار گوینده او نویسنده [sic]</colophon>
                <note>
                  <p>A note on f.1r records the purchase of this book by <persName role="fmo"
                      key="person_f7378">Muḥammad Karīm Allāh</persName> for 2 annas. </p>
                </note>
              </msItem>
            </msContents>
            <physDesc>
              <objectDesc form="codex">
                <supportDesc material="chart">
                  <extent>ff. 1r-13r<dimensions type="written" unit="mm">
                      <height>160</height>
                      <width>70</width>
                    </dimensions>
                  </extent>
                  <collation>
                    <p>Catchwords.</p>
                  </collation>
                </supportDesc>
                <layoutDesc>
                  <layout columns="2" writtenLines="13">
                    <p>Written in two columns with 13 lines per page on average.</p>
                  </layout>
                </layoutDesc>
              </objectDesc>
              <handDesc>
                <handNote>
                  <p>Shikastah nastaʻlīq; copied in black ink, with headings in red.</p>
                </handNote>
              </handDesc>
            </physDesc>
            <history>
              <origin calendar="Hijri qamari" notBefore="1700" notAfter="1799">Undated, probably
                18th century.</origin>
            </history>
            <additional>
              <listBibl>
                <bibl>R. Levy, <title>Drafts for Catalogue of Persian Manuscripts in the India
                    Office Library, vol. III</title>, <biblScope>
                    <ref target="http://www.bl.uk/manuscripts/Viewer.aspx?ref=mss_eur_e207!17_f024r"
                      type="n/a">Mss Eur E207/17, f. 24</ref>. </biblScope>
                </bibl>
              </listBibl>
            </additional>
          </msPart>
          <msPart xml:id="Uk_Delhi_Persian_1201-part2">
            <msIdentifier>
              <altIdentifier type="partial">
                <idno>Delhi Persian 1201b</idno>
              </altIdentifier>
            </msIdentifier>
            <msContents class="https://id.loc.gov/authorities/subjects/sh85121390">
              <summary>A popular account in ten sessions of legends surrounding the death of Shiʻa
                martyrs and other sacred figures; apparently an abbreviation by an unnamed author of
                the <title key="work_1605">Rawz̤at al-shuhadā</title> of<persName role="ant"
                  key="viaf_90770167">Ḥusayn ibn ʻAlī al-Vāʻiẓ al-Kāshifī</persName></summary>
              <msItem xml:id="Uk_Delhi_Persian_1201-part2-item1">
                <locus from="14r" to="78v">ff. 14r-78v</locus>
                <title xml:lang="fa-Latn-x-lc" key="work_6745">Dah majlis</title>
                <title xml:lang="fa" key="work_6745">ده مجلس</title>
                <textLang mainLang="fa">Persian</textLang>
                <incipit xml:lang="fa">اما راویات اخبار جگر سوز و ناقلان اثار غم اندوز</incipit>
                <explicit xml:lang="fa">القصه آن حضرت امام حسین علیه الصلوة والسلام همه را وداع کرد
                  و سوار شد انا لله و انا الیه راجعون</explicit>
                <colophon xml:lang="fa">تم تم تم تمام شد.</colophon>
                <note>
                  <p>The leaves are out of order at the beginning and probably were already so at
                    the time of binding since the owner Muḥammad Karīm Allāh's inscription is
                    written on f. 14r rather than on f. 24, which is the beginning of the work. The
                    correct order is ff. 24v-31, 14-23, 32-78. </p>
                  <p>A note beneath the colophon on f. 78v states that the manuscript was completed
                    on 17 Muḥarram 1197 AH (23 December 1782). </p>
                  <p>A note on f. 14r records that <persName role="fmo" key="person_f7378">Muḥammad
                      Karīm Allāh</persName> purchased the manuscript for 4 annas. </p>
                  <p>F. 78v contains Urdu verses on the martyrdom of <persName role="subject"
                      key="viaf_89661385">Ḥusayn ibn ʻAlī</persName>. </p>
                  <p>Includes marginal corrections. </p>
                </note>
              </msItem>
            </msContents>
            <physDesc>
              <objectDesc form="codex">
                <supportDesc material="chart">
                  <support>Some folios tinted </support>
                  <extent>ff. 14r-78v<dimensions type="written" unit="mm">
                      <height>153</height>
                      <width>80</width>
                    </dimensions>
                  </extent>
                  <collation>
                    <p>Catchwords </p>
                  </collation>
                </supportDesc>
                <layoutDesc>
                  <layout columns="1" writtenLines="13">
                    <p>13 to 15 lines per page</p>
                  </layout>
                </layoutDesc>
              </objectDesc>
              <handDesc>
                <handNote>
                  <p>Handwriting is inconsistent, with more than one copyist, moving between
                    nastaʻlīq and shikastah nastaʻlīq. Arabic sections in naskh. </p>
                </handNote>
              </handDesc>
            </physDesc>
            <history>
              <origin calendar="Hijri qamari" when-custom="1782-12-23">17 Muḥarram 1197 AH (23 Dec
                1782 CE)</origin>
            </history>
            <additional>
              <listBibl>
                <bibl>R. Levy, <title>Drafts for Catalogue of Persian Manuscripts in the India
                    Office Library, vol. III</title>, <biblScope>
                    <ref target="http://www.bl.uk/manuscripts/Viewer.aspx?ref=mss_eur_e207!17_f025r"
                      type="n/a">Mss Eur E207/17, f. 25</ref>. </biblScope>
                </bibl>
              </listBibl>
            </additional>
          </msPart>
        </msDesc>
      </sourceDesc>
    </fileDesc>


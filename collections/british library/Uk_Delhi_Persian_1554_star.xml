               <head>Handlist of Delhi Urdu collection</head>
               <msContents
                  class="http://id.loc.gov/authorities/subjects/sh97008481 http://id.loc.gov/authorities/subjects/sh85080778">
                  <summary>A hand-list of the Urdu manuscripts in the Delhi collection compiled in
                     the early 1860s, possibly as a preliminary to IO Islamic 4610<ref
                        target="https://www.fihrist.org.uk/catalog/manuscript_3309"/>. </summary>
                  <msItem xml:id="Uk_Delhi_Persian_1544-item1">
                     <title xml:lang="en" key="">Hand-list of Urdu manuscripts in the Delhi
                        collection</title>
                     <note>
                        <p>Title supplied. </p>
                        <p>Includes details arranged in columns headed old number (<hi rend="italic"
                              >sābiq</hi>) and new number (<hi rend="italic">jadīd</hi>), title,
                           author and notes (<hi rend="italic">kayfīyat</hi>) which include
                           descriptive comments on the script and paper. </p>
                     </note>
                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>
               </msContents>

               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc material="chart">
                        <support>Rebound and folios mounted on guards</support>
                        <extent>ff. 9<dimensions type="leaf" unit="mm">

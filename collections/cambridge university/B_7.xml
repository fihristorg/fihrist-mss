                    <msContents>
                        <summary>
                            <p>دلائل الخبرات</p>
                            <p>A copy of the well-known devotional work entitled Dalá ilu'l-Khayrát
                                by Abd Abdi'lláh Muhammad al-Jazúlí (d. 870/1465). See Brockelmann,
                                vol. 1, pp. 252-253.</p>
                            <p>B. 7 comprises ff. 85 of 17'7 x 11 c. and 13 ll.; good naskh with
                                rubrications within red and gold lines; copied at Karkúk in
                                1197/1783 by Muhammad Amin al-Anasi.</p>
                        </summary>
                        <msItem xml:id="B_7-item1">
                            <author key="person_60346321" ref="http://viaf.org/viaf/60346321/">
                                <persName xml:lang="ar-Latn-x-lc" type="standard">Jazūlī, Muḥammad
                                    ibn Sulaymān, d. 1465</persName>
                                <persName xml:lang="ar">محمد الجزولي <addName xml:lang="ar"
                                        type="kunyah">ابو محمد</addName>
                                </persName>
                            </author>
                            <title xml:lang="ar-Latn-x-lc" key="work_268" change="#ids-cleanup"
                                >Dalāʼil al-khayrāt</title>
                            <title xml:lang="ar" key="work_268" change="#ids-cleanup">دلائل
                                الخيرات</title>
                            <incipit xml:lang="ar"/>

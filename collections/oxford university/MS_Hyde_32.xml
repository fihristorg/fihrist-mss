               <msContents class="#multipleWorks">
                  <summary change="#add-summary2"> 5 works by 5 authors on the subjects of Astrology
                     and Astronomy </summary>
                  <msItem xml:id="MS_Hyde_32-item1" n="1">
                     <locus from="1" to="43">ff. 1r-43v</locus>
                     <author key="person_17355947" ref="http://www.viaf.org/viaf/17355947/"
                        change="#ids-cleanup">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Abū Maʻshar, <date
                              calendar="#Gregorian" when="0886">d. 886</date>
                        </persName>
                        <persName xml:lang="ar">أبو معشر الفلكي، جعفر بن محمد، ت. 272 ه</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_3817">Kitāb al-Qirānāt fī aḥkām
                        al-nujūm</title>
                     <title xml:lang="ar" key="work_3817">كتاب القرانات في أحكام النجوم</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم الحمد لله رب العالمين وصلواته على
                        سيدنا محمد خاتم النبيين وعلى آله وأصحابه أجمعين أما بعد فهذه أسطر تنضم شرح
                        قرانات الكواكب في البروج الأثني عشر</incipit>
                     <explicit xml:lang="ar">وإن انخسف القمر في آذار دل على ظهور الجراد وكثرة المياه
                        وجودة الفاد ... ويكثر الفساد وكلمة الشر بين الناس</explicit>
                     <colophon xml:lang="ar">تعليق العبد الفقير إلى عفو الله أحمد بن علي عرف بالعجمي
                        عقا الله عنهما ... في بعض شهور سنة أربعة وأربعين وسبعمائة لهجرة سيدنا رسول
                        الله صلى الله عليه وسلم وشرف وكرم</colophon>
                     <listBibl>
                        <bibl>GAL I 222</bibl>
                        <bibl>[NAM. 284 (1), with corrig. Nicoll p. 544]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Hyde_32-item2">
                     <locus from="44" to="54">ff. 44r-54v</locus>
                     <author key="person_f407">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Anonymous</persName>
                     </author>
                     <title xml:lang="en" key="">Astrological tables</title>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Hyde_32-item3" n="3">
                     <locus from="54" to="63">ff. 54v-63r</locus>
                     <author key="person_24571510" ref="http://viaf.org/viaf/24571510/">
                        <persName type="standard">Hermes, Trismegistus</persName>
                        <persName xml:lang="ar">هرمس وهو إدريس عليه السلام</persName>
                     </author>
                     <title key="work_3818">An astrological work on the predictions to be drawn from
                        the rising of Sirius</title>
                     <title xml:lang="ar-Latn-x-lc">Kitāb Hirmis wa-huwa Idrīs ʿalayhi al-salām fī
                        al-ḥukm ʿinda ṭulūʿ al-Shiʿrā</title>
                     <title xml:lang="ar" key="work_3818">كتاب هرمس وهو إدريس عليه السلام في الحكم
                        عند طلوع الشعرى </title>
                     <incipit xml:lang="ar">كتاب هرمس وهو إدريس عليه السلام في الحكم عند طلوع الشعرى
                        وما لها من الحوادث التي تكون في العالم في كل سنة مما علمه الله تعالى إياه
                        وأبناءه له نقله نفطويه الحكيم من اللسان القديم</incipit>
                     <explicit xml:lang="ar">فانظر في أي خمس من أخماس الحوت فاقض عليه من بلاد كوكب
                        ذلك الخمس والله أعلم بالصواب</explicit>
                     <colophon xml:lang="ar">تمت أحكام الشعرى على التمام</colophon>
                     <note>SAUG § 109, p. 190 (182)</note>
                     <listBibl>
                        <bibl>Appendix Hermetica</bibl>
                        <bibl>[NAM. 284 (2) with corrig. Nic. p. 558]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Hyde_32-item4" n="4">
                     <locus from="63" to="84">ff. 63r-84r</locus>
                     <author key="person_f407">Anonymous</author>
                     <title key="work_3819">A series of astronomical tables</title>
                     <listBibl>
                        <bibl>Appendix Astronomy</bibl>
                        <bibl>[Nicoll Arab .Mob. 284 (3), with corrig. Nicoll p. 544]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Hyde_32-item5" n="5" class="#extract">
                     <locus from="84" to="148">ff. 84v-148v</locus>
                     <author key="person_90042555" ref="http://viaf.org/viaf/90042555/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Rāzī, Fakhr al-Dīn
                           Muḥammad ibn ʻUmar, <date calendar="#Gregorian" from="1149" to="1210"
                              >1149 or 50-1210</date>
                        </persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6866" change="#ids-cleanup">Kitāb
                        al-Ikhtiyārāt</title>
                     <title xml:lang="ar" key="work_6866" change="#ids-cleanup">الاختيارات العلائية
                        فِي التأثيرات السماوية</title>
                     <note>Imperfect; extracts only?</note>
                     <incipit xml:lang="ar">باب علامة الشهور العربية الهلالية وحسابها من أول الشهر
                        إلى آخره وما يكون فيه من الخير والشر وما يؤمر فيه من البيع والشراء</incipit>
                     <explicit xml:lang="ar">ويضطر إبيه في العمل الذي يريد اختياره وهذا الجدول
                        المذكور على ما تشاهده وتراه في الوجه الآخر والله الموفق للصواب</explicit>
                     <listBibl>
                        <bibl>GAL I 507</bibl>
                        <bibl>[NAM. 284 (4)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

               <msContents class="#multipleWorks">
                  <summary change="#add-summary2"> 4 works by 3 authors on the subjects of Euclid's
                     Elements, Geometry, and Astronomy </summary>
                  <msItem xml:id="MS_Huntington_237-item1" n="1" class="#commentary">
                     <locus from="1" to="76">ff. 1r-76r</locus>
                     <author key="person_90038995" ref="http://viaf.org/viaf/90038995/">
                        <persName type="standard">Alhazen, 965-1039</persName>
                        <persName xml:lang="ar">ابن الهيثم، محمد بن الحسن، 354-حو. 430 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6534">Sharḥ muṣādarāt kitab Uqlīdus fī
                        uṣūl al-handasah</title>
                     <title xml:lang="ar" key="work_6534">شرح مصادرات كتاب اقليدس في أصول
                        الهندسة</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم رب يسر يا كريم قال الشيخ الامام
                        العالم الحكيم الفاضل الحسن بن الحسن بن الهيثم فيما شرحه لكتاب المصادرات
                        اقليدس من كتاب الاصول وان في ذلك لعبرة لاولي الأبصار</incipit>
                     <explicit xml:lang="ar">وارتفاعها خط ح الذي هو قطر الكرة وهو ضعف خط اه هي ضعف
                        اسطوانة ح وكرة الحد هي ثلثا الاسطوانة التي قاعدتها اعظم دائرة تقع في الكرة
                        وارتفاعها مساو لقطر الكرة وذلك ما اردنا ان نبين تم القول في مساحة الكرة
                        لأرشميدس</explicit>
                     <note>SAUG §90, p. 168</note>
                     <listBibl>
                        <bibl>GAL I 469</bibl>
                        <bibl>UAM. 908 (1)</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Huntington_237-item2" n="2" class="#translation">
                     <locus from="76" to="82">ff. 76r-82r</locus>
                     <author key="person_100218815" change="#ids-cleanup">
                        <persName>Autolykos</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6069">al-Kurah al-mutaḥarrikah</title>
                     <title xml:lang="ar" key="work_6069">الكرة المتحركة</title>
                     <note>Translated by <persName type="standard" xml:lang="ar-Latn-x-lc"
                           key="person_19690624" ref="http://viaf.org/viaf/19690624/" role="trl"
                           change="#role-assignment">Ḥunayn ibn Isḥāq al-ʻIbādī, <date
                              calendar="#Gregorian" from="0809" to="0873">809?-873</date>
                        </persName>
                        <persName xml:lang="ar" key="person_19690624">حنين بن إسحاق، 194-260
                           هـ</persName>
                     </note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم عونك اللهم يا قوي الرابع من
                        المتوسطات كتاب ولوطوقيوس في الكرة المتحركة بنقل حنين ابن اسحق</incipit>
                     <explicit xml:lang="ar">فاذا دار مركز الكرة فاذا كل واحد من دايرتي الحد دهـٮ
                        عظمى لان مركزها مركز الكرة وذلك ما اردنا ان نبين تم كتاب اولوطوفوس في الكرة
                        المتحركه والحمد لله رب العالمين</explicit>
                     <listBibl>
                        <bibl>GAL I 206</bibl>
                        <bibl>UAM. 908 (2)</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Huntington_237-item3" n="3" class="#abridgement">
                     <locus from="82" to="104">ff. 82r-104v</locus>
                     <author key="person_f407">Anonymous</author>
                     <title key="work_6535"> An abridgment (on the trisection of the right angle) of
                        part of <title xml:lang="ar-Latn-x-lc" key="work_iṣlaḥ_k_makhrūṭāt"> Iṣlāḥ
                           K. al-Makhrūṭāt</title> by <persName xml:lang="ar-Latn-x-lc"
                           key="person_f146" role="ant" change="#role-assignment">Abū Jaʿfar
                           Muḥammad ibn al-Ḥusayn</persName>
                        <persName xml:lang="ar">أبو جعفر محمد بن الحسين</persName>
                     </title>
                     <title xml:lang="ar" key="work_6535">إصلاح كتاب المخروطات</title>
                     <note> The work edited above ultimately derives from <persName type="standard"
                           key="person_64800866" role="ant" change="#role-assignment #ids-cleanup">
                           Apollonius of Perga </persName>
                        <persName xml:lang="ar" key="person_64800866">ابلونيوس</persName>
                     </note>
                     <note>*ascribed in the colophon to Autolycus, and entitled the 5th of the
                           <title xml:lang="ar-Latn-x-lc">Muwassiṭāt</title>
                        <title xml:lang="ar">الموسطات</title> [? = <title xml:lang="ar-Latn-x-lc"
                           >Mutawassiṭāt</title>
                        <title xml:lang="ar">المتوسطات</title> of <persName type="standard"
                           xml:lang="ar-Latn-x-lc" key="person_12392936"
                           ref="http://www.viaf.org/viaf/12392936/" role="att"
                           change="#role-assignment">Ṭūsī, Naṣīr al-Dīn Muḥammad ibn
                           Muḥammad, <date calendar="#Gregorian" from="1201" to="1274"
                              >1201-1274</date>
                        </persName>
                        <persName xml:lang="ar">النصير الطوسي، محمد بن محمد، 597-672 هـ </persName>
                     </note>
                     <note>cf., for Abū Jaʻfarʼs work, Algiers 1446/10</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم الخامس من الموسطات ما يحتاج اليه
                        من رسم القطوع المخروطية ومقدمات للمتوسطين ومسمه الزوايه المستقيمة الخطين ستة
                        اقسام وهذا القدر من علم قطوع المخروطات يكتفى به في معرفة ما ترسمه روس أظلال
                        المقاييس في كل يوم من أيام السنة وينتفع به في استخراج سمت القبلة</incipit>
                     <explicit xml:lang="ar">وليقطع هذا الكلام عند المشتهى ولله الحمد والمنة تم
                        الكتاب الخامس من الموسطات في المخروطات لاولوطونيوس والحمد لله وحده وصلواته
                        على خير خلقه محمد ونبيه واله الائمة (؟) الطاهرين وسلامه وحسبنا الله ونعم
                        الوكيل</explicit>
                     <listBibl>
                        <bibl>GAL I 219</bibl>
                        <bibl>UAM. 908 (3)</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Huntington_237-item4" n="4">
                     <locus from="104" to="123">ff. 104v-123r</locus>
                     <author key="person_f407">Anonymous</author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6536">Bayān maʻānī kayfīyat al-raṣd
                        al-muḥaqqiq [? muḥaqqaq]</title>
                     <title xml:lang="ar" key="work_6536">بيان معاني كيفية الرصد المحقق</title>
                     <incipit xml:lang="ar">بسم الله الرحيم وبه ثقتي وهو حسبي بيان معاني كيفية الرصد
                        المحقق يجمع أربعة وعشرين فصلاً في الطريق الذي به عرف ان الذي يتحرك من السماء
                        جسم مستمر على جميع الكواكب</incipit>
                     <explicit xml:lang="ar">لانه موافق لما وجدوه بالروية والرصد من حركاتها وملايم
                        الامور البعيدة عن السياد </explicit>
                     <colophon xml:lang="ar">تم كتاب الرصد بحمد الله وحسن توفيقه نهار الجمعة
                        اليوم الثامن من شهر رجب الاصب سنة ٩١٧ من الهجرة النبوية على صاحبها افضل
                        الصلاة والسلام والحمد لله رب العالمين</colophon>
                     <listBibl>
                        <bibl>Appendix Astronomy</bibl>
                        <bibl>UAM. 908 (4)</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
               </msContents>

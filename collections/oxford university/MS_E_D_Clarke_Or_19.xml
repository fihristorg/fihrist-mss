               <msContents class="#multipleWorks">
                  <summary change="#add-summary2"> 5 works by 4 authors on the subjects of
                     Philosophy, Koran, Love, and Astronomy </summary>
                  <msItem xml:id="MS_ED_Clarke_Or_19-item1" n="1">
                     <locus from="1" to="11">ff. 1-11r</locus>
                     <author key="person_89770781" ref="http://www.viaf.org/viaf/89770781/"
                        change="#ids-cleanup">
                        <persName type="standard">Avicenna, <date calendar="#Gregorian" from="0980"
                              to="1037">980-1037</date>
                        </persName>
                        <persName xml:lang="ar">ابن سينا، الحسين بن عبد الله، 370-428 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_4548">Risālat al-ḥudūd</title>
                     <title xml:lang="ar" key="work_4548">رسالة الحدود</title>
                     <title type="alt" xml:lang="ar-Latn-x-lc" key="work_4548">Fī ḥudūd al-ashyāʼ wa
                        rusūmihā</title>
                     <title xml:lang="ar" key="work_4548">في حدود الأشياء ورسومها</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم قال الشيخ أبو علي الحسين بن عبد
                        الله بن سينا وبعد فإن أصدقائي سألوني أن أملي عليهم حدود أشياء يطالبونني
                        بتحديدها</incipit>
                     <explicit xml:lang="ar">فالقديم بحسب الزمان هو الذي ليس له مبدأ زماني والقديم
                        بحسب الذات هو الذي ليس له مبدأ علي وهو الواحد الحق تعالى عما يقول الظالمون
                        علواً كبيراً</explicit>
                     <listBibl>
                        <bibl>GAL I 456</bibl>
                        <bibl>[NAM. 290 (1)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_ED_Clarke_Or_19-item2" n="2" class="#extract">
                     <locus from="11" to="12">ff. 11v, 12r</locus>
                     <author key="person_90042555" ref="http://viaf.org/viaf/90042555/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Rāzī, Fakhr al-Dīn
                           Muḥammad ibn ʻUmar, <date calendar="#Gregorian" from="1149" to="1210"
                              >1149 or 50-1210</date>
                        </persName>
                        <persName xml:lang="ar">الرازي، محمد بن عمر، 544-606 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_20517" change="#ids-cleanup">Mafātīḥ
                        al-ghayb</title>
                     <title xml:lang="ar">مفاتيح الغيب</title>
                     <note>An extract only, quoting the view of a certain philosopher on the
                        significance of sūrahs cxii and cxiv</note>
                     <incipit xml:lang="ar"> بسم الله الرحمن الرحيم قال الشيخ الإمام المحقق فخر
                        الملة والدين الرازي في تفسيره سمعت بعض العارفين فسر هاتين السورتين على وجه
                        عجيب</incipit>
                     <explicit xml:lang="ar">ثم إذا آل الامر إلى النتيجة فالعقل يساعد على النتيجة
                        والوهم يخنس ويرجع ويمتنع عن تسليم النتيجة فلهذا السبب سمى الوهم بالخناس ثم
                        بين سبحانه وتعالى أن ضرر هذا الخناس عظيم على العقل وأنه قلما ينفك </explicit>
                     <listBibl>
                        <bibl>GAL I 506</bibl>
                        <bibl>[NAM. 290 (2)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_ED_Clarke_Or_19-item3" n="3">
                     <locus from="12" to="22">ff. 12v-22v</locus>
                     <author key="person_89770781" ref="http://www.viaf.org/viaf/89770781/"
                        change="#ids-cleanup">
                        <persName type="standard">Avicenna, <date calendar="#Gregorian" from="0980"
                              to="1037">980-1037</date>
                        </persName>
                        <persName xml:lang="ar">ابن سينا، الحسين بن عبد الله، 370-428 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_3753">Risālah fī al-ʻishq</title>
                     <title xml:lang="ar">رسالة في العشق</title>
                     <incipit xml:lang="ar" key="work_3753">بسم الله الرحمن الرحيم سألت أسعدك الله يا أبا عبد الله
                        الفقيه المعصومي أن أجعل لك رسالة تتضمن إيضاح القول في العشق على سبيل الايجاز
                        فاطلبتك</incipit>
                     <explicit xml:lang="ar">لأن ما يرام التشبه به من الملك الأعظم لا يؤتى على غايته
                        وما يرام التشبه من الملوك الفانية قد يؤتى على مبلغه وإذ قد بلغنا هذا المبلغ
                        فلنختم الرسالة والحمد لله واهب العقل على ختمها كما هو أهله ومستحقه والصلوة
                        على نبينا محمد وآله أجمعين وعلى جميع الانبياء والمرسلين</explicit>
                     <listBibl>
                        <bibl>GAL I 456</bibl>
                        <bibl>[NAM. 290 (3)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_ED_Clarke_Or_19-item4" n="4">
                     <locus from="24" to="25">ff. 24v, 25r</locus>
                     <author key="person_f407">Anonymous</author>
                     <title key="work_4549">Three short fragments consisting of a philosophical
                        tract a work on a case of Arabic tautology, and a fāʼidah</title>
                     <note>The incipit/explicit of the first fragment:</note>
                     <incipit xml:lang="ar">انقسام المستقيم منها الذي تقال الشيء إما الذي لا يقبل
                        القسمة أصلا أو يقبلها</incipit>
                     <explicit xml:lang="ar">وتعريف الجسم المركب هو الذي ينقسم الى اقسام مختلفة
                        الطبائع نظر</explicit>
                     <note>The incipit/explicit of the second fragment:</note>
                     <incipit xml:lang="ar"> من لطائف الأستاذ العلامة شمس الملة والدين العطاري [?...]
                        لله الكاف في قوله تعالى ليس كمثله شيء زائدة ومنهم من قال المثل زايد </incipit>
                     <explicit xml:lang="ar"> وإذا لم يكن مثل مثله تعالى شيئا وجب أن لا يكون مثله
                        تعالى شيئا والله الموفق</explicit>
                     <note>The incipit/explicit of the third fragment:</note>
                     <incipit xml:lang="ar">الكرة جسم يحيط به سطح واحد في داخله نقطة تكون جميع
                        الخطوط الخارجة منها إلى ذلك السطح متساوية</incipit>
                     <explicit xml:lang="ar">وهي يوصف بكل هذه الاعتبارات بأنها أمر شانه أن يحصل له
                        أمر اخر في ذاته بعد أن يكون له وهو الذي يكون منه الشيء وموضوعه لا
                        بالعرض</explicit>
                     <listBibl>
                        <bibl>Appendix Philosophy</bibl>
                        <bibl>[NAM. 290 (4)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_ED_Clarke_Or_19-item5" n="5">
                     <locus from="26" to="57">ff. 26v-57r</locus>
                     <author key="person_5146153029805251752"
                        ref="http://www.viaf.org/viaf/5146153029805251752/" change="#ids-cleanup">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Jighmīnī, Maḥmūd ibn
                           Muḥammad, d. <date calendar="#Gregorian" when="1221" cert="unknown"
                              >1221?</date>
                        </persName>
                        <persName xml:lang="ar">الجغميني، محمود بن محمد</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_2801" change="#ids-cleanup"
                        >al-Mulakhkhaṣ fī al-hayʼah</title>
                     <title xml:lang="ar" key="work_2801">الملخص في الهيئة</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم الحمد لله كفاء إفضاله والصلوة على
                        نبيه محمد وآله [...] قال الشيخ محمود بن محمد بن عمر الجغميني الخوارزمي رحمه
                        الله إني ألفت هذا الكتاب في هيئة العالم تذكرة مني لبعدي لكل العالم [...]
                        وسميته الملخص في الهيئة </incipit>
                     <explicit xml:lang="ar">ولعل هذا المقدار الذي أوردت كاف لتحصيل ما أردت واف
                        بما جرت الإشارة إليه فالأولى أن اقتصر عليه فلتكن هذه خاتمة الكتاب والله أعلم
                        بالصواب وإليه المرجع والمآب</explicit>
                     <listBibl>
                        <bibl>GAL I 473</bibl>
                        <bibl>[NAM. 290 (5)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

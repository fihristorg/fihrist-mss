               <msContents class="#multipleWorks">
                  <summary change="#add-summary2"> 8 works by 8 authors on the subjects of
                     Arithmetic, Calendars, Astronomy, Medicine, Geometry, and Philosophy </summary>
                  <msItem xml:id="MS_Arab_f_65-item1" n="1" class="#commentary">
                     <locus from="1" to="20">ff. 1v-20v</locus>
                     <author key="person_56597947" ref="http://www.viaf.org/viaf/56597947/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Sibṭ al-Māridīnī, Badr
                           al-Dīn Muḥammad ibn Muḥammad, b. <date calendar="#Gregorian"
                              when="1423">1423</date>
                        </persName>
                        <persName xml:lang="ar">سبط المارديني، محمد بن محمد، 826-912 هـ</persName>
                     </author>
                     <title key="work_5329">Commentary on <title xml:lang="ar-Latn-x-lc">al-Lumaʻ
                           al-yasīrah fī ʻilm al-ḥisāb</title> of <persName type="standard"
                           xml:lang="ar-Latn-x-lc" key="person_56587788"
                           ref="http://www.viaf.org/viaf/56587788/" role="ant"
                           change="#role-assignment">Ibn al-Hāʼim, Aḥmad ibn Muḥammad, d. <date
                              calendar="#Gregorian" when="1412">1412</date>
                        </persName>
                        <title key="work_5329" xml:lang="ar"> تعليق على اللمع اليسيرة في علم الحساب
                           لابن الهائم، أحمد بن محمد، 753-815 هـ</title>
                     </title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وصلى الله على خير خلقه محمد وآله
                        وصحبه وسلم [...] فيقول محمد بن احمد بن سبط المارديني هذا تعليق مختصر جعلته
                        توضيحا على المقدمة المسماه باللمع في علم الحساب تاليف الشيخ [...] شهاب الدين
                        احمد بن الهائم </incipit>
                     <explicit xml:lang="ar"> وعلى هذا القياس وان شئت فانسب الخمسة عشر إلى الستين
                        يكن ربعا وهو الجواب وهذا أسهل وفي هذا القدر كفاية</explicit>
                     <listBibl>
                        <bibl>GAL II 125</bibl>
                        <bibl>[Beeston Pers. 2828 (1)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arab_f_65-item2" n="2">
                     <locus from="21" to="31">ff. 21v-31r</locus>
                     <author key="person_19535198" ref="http://www.viaf.org/viaf/19535198/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Qāḍī Mīr, Ḥusayn ibn
                           Muʻīn al-Dīn, d. <date calendar="#Gregorian" when="1504">1504 or
                              5</date></persName>
                        <persName xml:lang="ar">قاضي مير، حسين بن معين الدين، ت. 910 هـ</persName>
                     </author>
                     <title xml:lang="fa-Latn-x-lc" key="work_1883">Jām-i gītī-namā</title>
                     <title xml:lang="fa" key="work_1883">جام گیتی نما</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم سپاس بیقیاس حکیمی را که افکار
                        حکما و انظار علما در کنه معرفت او متحیر و پریشانند [...] این مختصر مسمّی
                        بجام گیتی نما بر وفق مشرب متاخرین حکما بر صحایف ظهور نگاشت </incipit>
                     <explicit xml:lang="fa"> و از هر جاه استنباط كند تا آن عقايد بمزيد استحكام و
                        رسوخ موصوف كردد و بدد جه يقين رسد انشاءالله تعالى اللهم ارنا الحق حقاً
                        وارزقنا اتباعه وارنا الباطل باطلا وارزقنا اجتنابه بحق نبينا محمد سيد الاولين
                        والآخرين وآله اجمعين الطيبين الطاهرين </explicit>
                     <colophon xml:lang="ar"> تم بحمد الله وتوفيقه والصلوة على نبيه وآله كتبه العبد
                        المذنب الراجى برب رحيم عبد الرزاق بن ابرهيم الناصرسرائي بتاريخ شهر محرم
                        الحرام سنة ۱۰۲۹ </colophon>
                     <listBibl>
                        <bibl>GAL II 210</bibl>
                        <bibl>[Cf. Ethé 414, with corrig. Beeston p. 101]</bibl>
                     </listBibl>
                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arab_f_65-item3" n="3">
                     <locus from="32" to="35">ff. 32v-35v</locus>
                     <author>
                        <persName>Anonymous</persName>
                     </author>
                     <note>A medical treatise on the preservation of health</note>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم الحمد لله رب العالمين والصلوة
                        والسلام على خير خلقه محمد النبي وآله وصحبه اجمعين چون بهترین نعمتها به
                        بندگان تندرستی ونگاه داشت اين نعمت واجب امد [...] جالينوس گوید نگاه داشت
                        تندرستی ده گونه است </incipit>
                     <explicit xml:lang="fa"> و مانند ایشان بس آندر نگاه داشت تدبیر طعام و شراب رای
                        [ ? ] بزرگ آندرین باب [ ? ] شرح هر یک مشغول شویم دراز شود و غرض ما آندرین
                        رساله خردمندانرا بر نگاه درست تندرستی و الله الموفق </explicit>
                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arab_f_65-item4" n="4">
                     <locus from="36" to="41">ff. 36v-41v</locus>
                     <author>
                        <persName>Anonymous</persName>
                     </author>
                     <title xml:lang="fa-Latn-x-lc">Ījāz al-Ḥikam</title>
                     <title xml:lang="fa">ایجاز الحکم</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم الحمد لله رب العالمين والعاقبة
                        للمتقين وصلوة على رسوله محمد وآله اجمعين اما بعد بدانكه آن علوم مختصر است در
                        علم حكمت مبين و مبرهن [...] واين رساله را ايجاز الحكم نام نهاده شد. </incipit>
                     <explicit>پس صفات را در جناب حضرت او که اطلاق کرده اند جز بطریق تفهیم و کامل
                        دانستن عوام ذات او را هیچ فایدۀ دیگر نیست بلکه او خود منزه است از تنزیه و از
                        تنزیه تنزیه وهو تعالی عما يقول الظالمون علوا كبيرا والحمد لله المنعم
                        المفضل</explicit>
                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arab_f_65-item5" n="5">
                     <locus from="42" to="53">ff. 42v-53v</locus>
                     <author key="person_f407">Anonymous</author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5330">Risālah fī aʻmāl al-awqāt fī
                        istikhrāj al-sumūt wa-al-jihāt</title>
                     <title xml:lang="ar" key="work_5330">رسالة في أعمال الأوقات في إستخراج السموت
                        والجهات</title>
                     <note>[on the sine quadrant, in a muqaddimah and eleven bābs]</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم الحمد الله رب العالمين والصلوة
                        والسلام على سيدنا محمد واله وصحبه وسلم وبعد فهذه رسالة على ربع المجيب
                        الافاقي في الاعمال الفلكية المحتاجة اليها سميتها رسالة في اعمال الاوقات في
                        استخراج السموت والجهات </incipit>
                     <explicit xml:lang="ar">لقد رسمت القبلة خطب على سمت القبلة فطرفه الذي على محيط
                        الربع هو القبلة والله اعلم تمت رسالة ربع المجيب في اعمال الفلكية </explicit>
                     <listBibl>
                        <bibl>Appendix Astronomy</bibl>
                        <bibl>[Beeston Pers. 2828 (6)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arab_f_65-item6" n="6">
                     <locus from="55" to="110">ff. 55v-110v</locus>
                     <author key="person_27052262" ref="https://www.viaf.org/en/viaf/27052262">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">ʻĀmilī, Bahāʼ al-Dīn
                           Muḥammad ibn Ḥusayn, d. <date calendar="#Gregorian" from="1547"
                              to="1621">1547-1621</date></persName>
                        <persName xml:lang="ar">بهاء الدين العاملي، محمد بن حسين، 953-1031
                           هـ</persName>
                     </author>
                     <title xml:lang="fa-Latn-x-lc" key="work_6345">Dar maʼrifat-i ālāt-i
                        asṭurlāb</title>
                     <title xml:lang="fa" key="work_6345">در معرفت آلات اسطرلاب</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم الحمد لله رب العلمين والسلام على
                        خاتم الانبياء والمرسلين محمد [...] ودر فن اسطرلاب كه اشرف فروع علم رياضى است
                        خوض نموده [...] اين مخلص صميمى محمد المشتهر ببهاء الدين العاملى </incipit>
                     <explicit xml:lang="fa"> واگر زمان شناختن آن قريب باشد شناختن باين طريق در كمال
                        سهولت [و آسانى ?] واين رساله بر لفظ سهولت اختتام يافت </explicit>
                     <listBibl>
                        <bibl>GAL II 415</bibl>
                        <bibl>[Ethé 1508]</bibl>
                     </listBibl>
                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arab_f_65-item7" n="7">
                     <locus from="111" to="157">ff. 111r-157r</locus>
                     <author key="person_12392936" ref="http://www.viaf.org/viaf/12392936/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Ṭūsī, Naṣīr al-Dīn
                           Muḥammad ibn Muḥammad, <date calendar="#Gregorian" from="1201"
                              to="1274">1201-1274</date>
                           <persName xml:lang="ar">النصير الطوسي، محمد بن محمد، 597-672
                              هـ</persName>
                        </persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6328" change="#ids-cleanup">Taḥrīr
                        Kitāb Ukar <foreign xml:lang="la">[De sphaera]</foreign> li- <persName
                           key="person_25377100" ref="http://viaf.org/viaf/25377100/"
                           type="standard" role="ant" change="#role-assignment #ids-cleanup"
                           >Theodosius, <date calendar="#Gregorian" notBefore="-0100"
                              notAfter="0001">1st cent. B.C.</date>
                        </persName>
                     </title>
                     <title xml:lang="ar" key="work_6328">تحرير كتاب الأكر </title>
                     <note>Lacking beginning</note>
                     <incipit xml:lang="ar">السطح هو مقدار بزاوية حادة محيط بها خطان مستقيمان يخرجان
                        في كل المسطحين ومتقاطعان على الفصل المشترك لها </incipit>
                     <explicit xml:lang="ar">شبهه لقوس لح فقوس م ى اعظم ان يكون شبهه لقوس لح وهو
                        المطلوب والله اعلم</explicit>
                     <colophon xml:lang="ar">تم كتاب الاكر لثاودوسيوس الجمعة من اوائل جمادي الاول
                        سنة 4 وألف من هجرة النبي على صاحبها الف الف صلوة والسلام </colophon>
                     <listBibl>
                        <bibl>GAL I 511</bibl>
                        <bibl>[Beeston Pers. 2828 (8)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Arab_f_65-item8" n="8">
                     <locus from="158" to="181">ff. 158v-181v</locus>
                     <author key="person_105133145" ref="http://viaf.org/viaf/105133145/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Fārābī</persName>
                        <persName xml:lang="ar">الفارابي، محمد بن محمد، 260-339 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_4165" change="#ids-cleanup">al-Jamʻ
                        bayn raʼyay Aflāṭūn wa-Aristū</title>
                     <title xml:lang="ar" key="work_4165"> الجمع بين رأيي أفلاطون وأرسطو</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم الحمد الله الواهب العقل ومبدعه
                        ومصور الكل ومخترعه [...] مقالة لابى نصر الفارابي في الجمع بين رأيي أفلاطون
                        وأرسطو </incipit>
                     <explicit xml:lang="ar"> فمن تأمل ما ذكرناه من اقاويل هذين الحكيمين ثم لم </explicit>
                     <note>Lacking last 4 lines of text</note>
                     <listBibl>
                        <bibl>GAL I 212</bibl>
                        <bibl>[Beeston Pers. 2828 (9)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
               </msContents>

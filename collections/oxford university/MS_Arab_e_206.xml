               <msContents class="#multipleWorks">
                  <summary change="#add-summary2"> 7 works by 6 authors on the subjects of
                     Mathematics, Inheritance and succession, and Astronomy </summary>
                  <msItem xml:id="MS_Arab_e_206-item1" n="1">
                     <locus from="1" to="20">ff. 1v-20v</locus>
                     <author key="person_97052246" ref="http://viaf.org/viaf/97052246/"
                        change="#ids-cleanup">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Qalaṣādī, ʻAlī ibn
                           Muḥammad, <date calendar="#Gregorian" from="1412" to="1487">1412 or
                              13-1486 or 7</date>
                        </persName>
                        <persName xml:lang="ar">القلصادي، علي بن محمد، 815-891 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_4838">Kashf al-asrār ʻan ʻilm ḥurūf
                        al-ghubār</title>
                     <title xml:lang="ar" key="work_4838">كشف الأسرار عن علم حروف الغبار</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم صلى الله على سيدنا محمد وآله يقول
                        عبد الله تعالى علي بن محمد بن علي القرشي الشاهر بالقلصادي البسطى وفقه الله
                        ورضي عنه الحمد لله سريع الحساب مسبل النعماء وفاتح الأبواب والصلوة والسلام
                        على سيد الكونين المبعوث الى الثقلين اما بعد فهذه نبذة كافية شافية وعن جانبي
                        الإخلال والإملال متجافية</incipit>
                     <explicit xml:lang="ar">وهذا آخر ما قصدنا من هذا الموضوع وربنا المسئول أن ينفع
                        به كل من يشتغل به إنه ولي المتقين وهو حسبنا ونعم الوكيل ولا حول ولا قوة إلا
                        بالله العلي العظيم وصلى الله على سيدنا محمد وآله وصحبه وسلم تسليما كثيرا إلى
                        يوم الدين</explicit>
                     <colophon xml:lang="ar">انتهى بحمد الله تعالى وحسن عونه وتوفيقه الجميل وكان
                        الفراغ من هذا الكتاب المبارك في يوم الاربعا عند الزوال في شهر الله المبارك
                        جمادى الاول بعد ما خلا منه عشرة ايام عام 1226 على يد الحقير الذليل الراجي
                        عفو ربه محمد بن أبي مدين الشعيبي الفجاوي غفر الله له ولوالديه
                        آمين</colophon>
                     <listBibl>
                        <bibl>GAL II 266</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arab_e_206-item2" n="2">
                     <locus from="21" to="40">ff. 21v-40r</locus>
                     <author key="person_97052246" ref="http://viaf.org/viaf/97052246/"
                        change="#ids-cleanup">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Qalaṣādī, ʻAlī ibn
                           Muḥammad, <date calendar="#Gregorian" from="1412" to="1487">1412 or
                              13-1486 or 7</date>
                        </persName>
                        <persName xml:lang="ar">القلصادي، علي بن محمد، 815-891 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6454">Irshād al-mutaʻallim wa-tanbīh
                        al-muʻallim bi-farāʼiḍ al-shaykh al-imām Khalīl</title>
                     <title xml:lang="ar" key="work_6454">إرشاد المتعلم وتنبيه المعلم بفرائض الشيخ
                        الإمام خليل</title>
                     <note>A commentary on the sections dealing with the <term
                           xml:lang="ar-Latn-x-lc">farāʼiḍ</term> in the <title
                           xml:lang="ar-Latn-x-lc">Mukhtaṣar</title> of <persName
                           xml:lang="ar-Latn-x-lc" type="standard" key="person_301832738" role="ant"
                           change="#role-assignment">Khalīl ibn Isḥāq al-Jundī, <date
                              calendar="#Gregorian" when="1365">d. 1365</date>
                           <persName xml:lang="ar">الشيخ خليل، ت. 776 هـ</persName>
                        </persName>
                     </note>
                     <note>*date on f. 20v 1810</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وصلى الله على سيدنا محمد وآله
                        الحمد لله رب العالمين وصلى الله على سيدنا محمد خاتم النبيين اما بعد فهذه </incipit>
                     <explicit xml:lang="ar">فعليه بإمام هذه الصناعة أبى القاسم الحوجي رضي الله عنه
                        وصلى الله على سيدنا محمد اله صحبه سلم تسليما كتيرا الى يوم الدين والحمد الله
                        رب العالمين</explicit>
                     <listBibl>
                        <bibl>GAL II 84</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arab_e_206-item3" n="3">
                     <locus from="41" to="59">ff. 41v-59r</locus>
                     <author key="person_f2720">
                        <persName xml:lang="ar-Latn-x-lc">Muḥammad ibn Masʻūd al-?Harīnī <date
                              calendar="#Gregorian" when="1616">fl. c. 1616*</date>
                        </persName>
                        <persName xml:lang="ar">محمد بن مسعود الحريني؟</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6455">al-Najm al-wahhāj fī ḥall ʻuqad
                        al-Minhāj</title>
                     <title xml:lang="ar" key="work_6455">النجم الوهاج في حل عقد المنهاج</title>
                     <note>A commentary on 19 of the 24 bābs of the <title xml:lang="ar-Latn-x-lc"
                           >Minhāj al-ṭālib li-taʻdīl al-kawākib</title>
                        <title xml:lang="ar">منهاج الطالب لتعديل الكواكب</title> of <persName
                           type="standard" xml:lang="ar-Latn-x-lc" key="person_47152278"
                           ref="http://viaf.org/viaf/47152278/" role="ant" change="#role-assignment"
                           >Ibn al-Bannāʼ, Aḥmad ibn Muḥammad, <date calendar="#Gregorian"
                              from="1256" to="1321">1256?-1321?</date>
                        </persName>
                        <persName xml:lang="ar" key="person_47152278">ابن البناء، أحمد بن محمد،
                           654-721 هـ</persName>
                     </note>
                     <note>*A. H. 1025 given as date of composition of the work, f. 59r 1.5</note>
                     <note>**date on f. 20v 1810</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم صلى الله على سيدنا محمد وآله
                        وصحبه وسلم تسليما يقول عبيد الله تعالى واقل عبيده محمد بن مسعود الحرينى لطف
                        الله به الحمد لله الذي كان ولم يكن شيئا معه، وكون العالم من لا شيء واخترعه،
                        واستوى على العرش بالا حالة وقهر ، وجعل عدة الافلاك تسعة مقيدة، واوحى لكل فلك
                        يدبر امره، وخلق النجوم في سبعة افلاك موزعة، مقسمة على ثلاثة اقسام
                        مبينة</incipit>
                     <explicit xml:lang="ar"> والحمد لله رب العالمين وصلى الله على سيدنا محمد وآله
                        وصحبه وسلم تسليماً </explicit>
                     <colophon xml:lang="ar">ووافق الفراغ منه فراغ تاليفه في شهر الله الفضيل ربيع
                        النبوي ليلة 8 أيام منه على كمل الشرح المبارك بحمد الله تعالى وبركاته وغفر
                        الله لكاتبه آمين يا رب العالمين</colophon>
                     <listBibl>
                        <bibl>GAL II 255</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>

                  </msItem>
                  <msItem xml:id="MS_Arab_e_206-item4" n="4">
                     <locus from="59" to="60">ff. 59r-60r</locus>
                     <author key="person_f311">
                        <persName xml:lang="ar-Latn-x-lc">Ahmad ibn ʻAlī al-Sharīf
                           al-?Ḥasanī</persName>
                        <persName xml:lang="ar">أحمد بن علي الشريف الحسني؟</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6456">Nubdhah tafhīm ʻan māhīyah
                        ḥarakat al-iqbāl</title>
                     <title xml:lang="ar" key="work_6456">نبذة تفهيم عن ماهية حركة الإقبال</title>

                     <note>An introduction to astronomy</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وصلى الله على نبينا محمد واله قال
                        الشيخ الإمام المحقق سيدى أحمد بن سيدى على الشريف الحسنى حمداً لمن ابدع دقائق
                        الاشيا بحكمته، وخلق بعضها ساكنا ثم حركه، والصلاوة على قطب الوجود، والسبب في
                        كل موجود، وبعد</incipit>
                     <explicit xml:lang="ar">فإذا تصور الإنسان هذه الأمر اتضح له أمر الحركة وهذه
                        صورة الدائر تبين المذكور قيس لم يكمل هذا</explicit>
                     <listBibl>
                        <bibl>Appendix Astronomy</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>

                  </msItem>
                  <msItem xml:id="MS_Arab_e_206-item5" n="5">
                     <locus from="60" to="60">f. 60v</locus>
                     <author key="person_f407">Anonymous</author>
                     <title key="work_6457">A short explanation of how to determine in which signs
                        of the zodiac the various planets etc. are to be found</title>
                     <note>f. 61r is blank</note>
                     <incipit xml:lang="ar"> باب اس المقاتل [?] إذا أردت أن تعلم أي برج هو فيه فانظر
                        ما مضى من سني الهجرة، وزد عليه خمس سنين ثم اطرح ما اجتمع تسعة وعشرين سنة </incipit>
                     <explicit xml:lang="ar">وزد عليه خمس أيام وازد من منزلة الشمس التى اتت فيها
                        وتعطي لكل برج خمس أيام بحيث نعد العدد فالقمر في ذلك البرج</explicit>
                     <listBibl>
                        <bibl>Appendix Astronomy</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>

                  </msItem>
                  <msItem xml:id="MS_Arab_e_206-item6" n="6" class="#commentary">
                     <locus from="61" to="93">ff. 61v-93r</locus>
                     <author key="person_90039514" ref="http://viaf.org/viaf/90039514/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Mirightī, Muḥammad ibn
                           Saʻīd, <date calendar="#Gregorian" from="1598" to="1679">1598 or 9-1678
                              or 9</date>
                        </persName>
                        <persName xml:lang="ar">المرغتي، محمد بن سعيد، 1007-1089 هـ</persName>
                     </author>
                     <title key="work_6458">al-Mumtiʻ fī sharh al-Muqniʻ</title>
                     <title xml:lang="ar" key="work_6458">الممتع في شرح المقنع</title>
                     <note>The authorʼs commentary on his own <title xml:lang="ar-Latn-x-lc"
                           >al-Muqniʻ fī ʻilm Abī Muqriʻ</title>
                     </note>
                     <note>f. 93 contains a note on the 28 phases on the moon (manāzil)</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم صلى الله على سيدنا محمد وآله قال
                        الشيخ الفقيه النحوي الأديب المحدت العالم العلامة سيدي محمد بن سعيد بن يحيى
                        الأميرى المرغيتي أطال الله جنانه وأدام النفع به آمين يا رب العالمين </incipit>
                     <explicit xml:lang="ar">سعد السعود يطلع الثالث عشر من فبراير وهو كوكبان
                        هكذا</explicit>
                     <colophon xml:lang="ar">وكان الفراغ منه يوم الاثنين في الضحى في شهر الله ربيع
                        الثاني في عام ١٢٢٢</colophon>
                     <listBibl>
                        <bibl>GAL II 463</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>

                  </msItem>
                  <msItem xml:id="MS_Arab_e_206-item7" n="7" class="#commentary">
                     <locus from="94" to="183">ff. 94r-183v</locus>
                     <author key="person_314808948" ref="http://viaf.org/viaf/314808948/"
                        change="#ids-cleanup">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Binnīs, Muḥammad ibn
                           Aḥmad, <date calendar="#Gregorian" from="1747" to="1798">ca. 1747-1798
                              or 9</date>
                        </persName>
                        <persName xml:lang="ar"> محمد بن أحمد البنيس </persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6459">Bahjat al-baṣar fī sharḥ farāʼiḍ
                        al-Mukhtaṣar</title>
                     <title xml:lang="ar" key="work_6459">بهجة البصر في شرح فرائض المختصر</title>
                     <note>A commentary on the sections dealing with the <term
                           xml:lang="ar-Latn-x-lc">farāʼiḍ</term> in the <title
                           xml:lang="ar-Latn-x-lc">Mukhtaṣar</title> of <persName
                           xml:lang="ar-Latn-x-lc" type="standard" key="person_301832738" role="ant"
                           change="#role-assignment">Khalīl ibn Isḥāq al-Jundī, <date
                              calendar="#Gregorian" when="1365">d. 1365</date>
                        </persName>
                     </note>
                     <note>*? is the "yaum al-sabt" of the colophon to be identified with the "yaum
                        al-sabt 4th Ramaḍān 1221" (= 1806) of the last 2 lines of the text</note>
                     <incipit xml:lang="ar"> بسم الله الرحمن الرحيم وصلى الله على سيدنا محمد وآله إن
                        أولى ما ورثه الإنسان من الفروض وأحسن ما قام به من المسنون والمفروض وأعلى ما
                        استفتح به الخطاب واحلى ما اختتم [?] به شكر الوهاب وأبهى ما لفظت به شفاه
                        الأعلام الأكابر وأزهى ما خطبت به الافواه على المنابر</incipit>
                     <explicit xml:lang="ar">وصلى الله على سيدنا محمد المصطفى الكريم وعلى آله وصحبه
                        وسلم ووافق الفراغ منه عند صلوةالدهر يوم السبت رابع رمضان المعظم سنة إحدى
                        وعشرين ومائتين وألف مـ</explicit>
                     <colophon xml:lang="ar">كمل بحمد الله وحسن عونه وتوفيقه الجميل ووافق الفراغ من
                        كتب هذا المبارك يوم السبت كاتبه لنفسه ثم لمن شاء الله من بعده اللهم اغفر لنا
                        ولوالدينا ولاشياخنا ولجميع المسلمين والحمد لله رب العالمين ولا حول ولا قوة
                        الا بالله العلى العظيم وصلى الله على سيدنا محمد وآله وصحبه وسلم تسليما بالله
                        ان نظرت عيناك الى ما صنعت يد الفقير الى غفران من الله فاقرا مهديا ام الكتاب
                        [...?] </colophon>
                     <listBibl>
                        <bibl>GAL II 84</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
               </msContents>

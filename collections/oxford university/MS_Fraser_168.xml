                  <summary change="#add-summary2"> 7 works by 6 authors on the subjects of
                     Astrolabes, Astronomical instruments, Astronomy, Prosody, Arithmetic, and
                     Geomancy </summary>
                  <msItem xml:id="MS_Fraser_168-item1" n="1">
                     <locus from="1" to="21">ff. 1b-21b</locus>
                     <author key="person_12392936" ref="http://www.viaf.org/viaf/12392936/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Ṭūsī, Naṣīr al-Dīn
                           Muḥammad ibn Muḥammad, <date calendar="#Gregorian" from="1201"
                              to="1274">1201-1274</date>
                        </persName>
                        <persName xml:lang="ar">النصير الطوسي، محمد بن محمد، 597-672 هـ</persName>
                     </author>
                     <title xml:lang="fa-Latn-x-lc" key="work_7164" change="#ids-cleanup">Bīst bāb
                        [dar maʻrifat-i Asṭurlāb]</title>
                     <title xml:lang="fa" key="work_7164">بيست باب در معرفت اصطرلاب</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم الحمد لله رب العالمين والصلوة على
                        محمد و آله اما بعد این مختصریست در معرفت اصطرلاب مشتمل بر بیست باب باب اول
                        در معرفت القاب آلات و خطوط و دوایر اصطرلاب</incipit>
                     <explicit xml:lang="fa">هر که آنرا بشناسد چنانکه در آن اشتباه نبیند اورا درين
                        باب کفایت باشد اينست تمامى سخن در معرفت اسطرلاب والله اعلم
                        بالصواب</explicit>
                     <colophon xml:lang="ar">في شهور سنة ١٠١٧</colophon>
                     <listBibl>
                        <bibl>GAL I 512</bibl>
                        <bibl>
                           <ref
                              target="https://archive.org/stream/catalogueofpersi01bodluoft#page/462/mode/2up"
                              >Ethé 1503</ref>
                        </bibl>
                     </listBibl>
                     <textLang mainLang="ar" otherLangs="fa">Arabic, Persian</textLang>
                  </msItem>
                  <msItem xml:id="MS_Fraser_168-item2" n="2">
                     <locus from="23" to="64">ff. 23b-64a</locus>
                     <author key="person_90047204" ref="http://viaf.org/viaf/90047204/">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Qūshjī, ʻAlī ibn Muḥammad,
                           d. <date calendar="#Gregorian" when="1475">1474 or 5</date>
                        </persName>
                        <persName xml:lang="ar">القوشجي، علي بن محمد، ت. 879 هـ</persName>
                        <persName xml:lang="ar-Latn-x-lc" type="alt">al-Qawshajī, ʻAlī ibn Muḥammad,
                           ʻAlāʼ al-Dīn</persName>
                        <persName xml:lang="ar">القوشجي، علي بن محمد، علاء الدين</persName>
                     </author>
                     <title xml:lang="fa-Latn-x-lc" key="work_4319">Risālah dar ʻilm-i
                        hayʼat</title>
                     <title xml:lang="fa" key="work_4319">رساله در علم هیئت</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم وبه نستعين رب يسر ولا تعسر الحمد
                        لله رب العالمين ... اما بعد اين كتاب مشتمل است بر مقدمه و دو مقاله</incipit>
                     <explicit xml:lang="fa">و اعظم ثوابت مرصوده دويست و بيست و دو برابر زمين است و
                        اصغر ثوابت مرصوده بيست بيست و سه برابر زمين است</explicit>
                     <colophon xml:lang="fa">تمت كتابت هذه الرساله على يد اضعف الطلبه واحوجهم عبد
                        الوحيد كيلانى فى شهور جمادى الثانى من شهور سنه اثنى عشر والف تم</colophon>
                     <textLang mainLang="fa">Persian</textLang>
                     <listBibl>
                        <bibl>
                           <ref
                              target="https://archive.org/stream/catalogueofpersi01bodluoft#page/466/mode/2up"
                              >Ethé 1535</ref>
                        </bibl>
                     </listBibl>
                  </msItem>
                  <msItem xml:id="MS_Fraser_168-item3" n="3">
                     <locus from="65" to="103">ff. 65b-103a</locus>
                     <author key="person_90047204" ref="http://viaf.org/viaf/90047204/">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Qūshjī, ʻAlī ibn Muḥammad,
                           d. <date calendar="#Gregorian" when="1475">1474 or 5</date>
                        </persName>
                        <persName xml:lang="ar">القوشجي، علي بن محمد، ت. 879 هـ</persName>
                        <persName xml:lang="ar-Latn-x-lc" type="alt">al-Qawshajī, ʻAlī ibn Muḥammad,
                           ʻAlāʼ al-Dīn</persName>
                        <persName xml:lang="ar">القوشجي، علي بن محمد، علاء الدين</persName>
                     </author>
                     <title xml:lang="fa-Latn-x-lc" key="work_4318">Risālah dar ʻilm-i ḥisāb</title>
                     <title xml:lang="fa" key="work_4318">رساله در علم حساب</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم وبه الحمد لله رب العالمين ... اما
                        بعد اين رساله ايست در حساب مشتمل بر سه مقاله</incipit>
                     <explicit xml:lang="fa">يعنى مستدير و مضلع و قايم و مايل حاصل ضرب قاعده است در
                        ارتفاع</explicit>
                     <colophon xml:lang="fa">تمت الرساله في ثامن شهر ذى الحجه سنه ٩٩٥ كاتب الحروف
                        شمس الدين على ابن سيد مير حسن الحسينى غفر ذنوبهما وستر عيوبهما بمحمد
                        وآله</colophon>
                     <textLang mainLang="fa">Persian</textLang>
                     <listBibl>
                        <bibl>
                           <ref
                              target="https://archive.org/stream/catalogueofpersi01bodluoft#page/466/mode/2up"
                              >Ethé 1529</ref>
                        </bibl>
                     </listBibl>
                  </msItem>
                  <msItem xml:id="MS_Fraser_168-item4" n="4" class="#abridgement">
                     <locus from="105" to="126">ff. 105b-126a</locus>
                     <author key="person_78769310" ref="http://viaf.org/viaf/78769310/"
                        change="#ids-cleanup">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Kāshī, Jamshīd ibn
                           Masʻūd, <date calendar="#Gregorian" when="1436">d. ca. 1436</date>
                        </persName>
                        <persName xml:lang="ar">جمشيد بن مسعود، ت. 823 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_20416" change="#ids-cleanup">Talkhīs
                        al-Miftāḥ</title>
                     <title xml:lang="ar" key="work_20416">تلخيص المفتاخ</title>
                     <note>A compendium of his own <title xml:lang="ar-Latn-x-lc" key="work_10284"
                           >Miftāḥ al-ḥussāb fī al-ḥisāb</title><title xml:lang="ar"
                           key="work_10284">مفتاح الحسّاب في الحساب</title>
                     </note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وبه ثقتي الحمد لله الواحد اللأحد
                        الفرد القديم الصمد الذي آلائه غير محدودة ونعمائه غير محصورة [...]أما بعد فإن
                        أحوج خلق الله تعالى إلى غفرانه جمشيد بن مسعود بن محمود الطبيب الكاشاني
                        الملقب بغياث أحسن الله أحواله يقول لما عرفت [فرغت؟] من تحرير كتابي المسمى
                        بمفتاح الحساب فانتخبت منه هذا المختصر... وسميته تلخيص المفتاح </incipit>
                     <explicit xml:lang="ar">ضرب جذر احد العددين في جذر الآخر ولنختم الكلام ههنا
                        حامدين لله تع و مصلين على رسوله وعلى آله واصحابه مفاتيح الهدى</explicit>
                     <colophon xml:lang="ar">ووقع الفراغ من تسويد هذه النسخة الشريفة على يد اضعف
                        عباد الله عبد الوحيد بن شيخمير تم في تاريخ شهر جمادى الآخر سنة إحدى عشر
                        وألف</colophon>
                     <note>Margin notes date of completion as Jumādī al-Ākhar 1011, or 1602.</note>
                     <listBibl>
                        <bibl>GAL II 211</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Fraser_168-item5" n="5">
                     <locus from="126" to="128">ff. 126v-128r</locus>
                     <author key=""><persName xml:lang="ar-Latn-x-lc">Muḥammad ibn
                           Manṣūr</persName><persName xml:lang="ar">محمد بن
                        منصور</persName></author>
                     <title xml:lang="en" key="">On the moon's halo</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم بعد از تیمن و تبرک بنام مبدعی که
                        بمحض جود ذرات کائنات را از کتم عدم بستان وجود فرستاد و درود نامحدود بر حضرت
                        محمد میگوید محرر این سطور محمد بن منصور که غرض تحریر این اوراق بیان کیفیت
                        حدوث این خرمن ماه است که آنرا بتازی هاله گویند</incipit>
                     <explicit xml:lang="fa"> بلكه انسان‌العین اعیان [?] است که سیر که مقتضی شد
                        دایره که [?] برد دایره ارغوانی باشد بدین‌طورالحاق نمایید والحمد لله اولاً و
                        آخراً تم.</explicit>
                     <listBibl>
                        <bibl>
                           <ref
                              target="https://archive.org/stream/catalogueofpersi01bodluoft#page/470/mode/2up"
                              >Ethé 1550</ref>
                        </bibl>
                     </listBibl>
                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>
                  <msItem xml:id="MS_Fraser_168-item6" n="6">
                     <locus from="129" to="152">ff. 129a-152b</locus>
                     <author key="person_90042997">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Jāmī, 1414-1492</persName>
                        <persName xml:lang="fa">جامى</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_2393">Risālah fī al-ʻarūḍ</title>
                     <title xml:lang="ar" key="work_2393">رسالة في العروض</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحیم و به شکر و سپاس وآفر قادري را که
                        حرکت سریع دوائر افلاک را سبب ازدواج اصول و امتزاج ارکان </incipit>
                     <explicit xml:lang="fa">فعْلُن فعْلُن مقطوع ۴ مردم آیم سویت باشد بینم رویت فعلن
                        فعلن فعلن تمه</explicit>
                     <colophon xml:lang="fa">قد وقع الفراغ من تسويد هذه الرسالة الشريفة على يد اضعف
                        عباد الله واهونهم عبد الوحيد رانکوی في تحرير تاریخ سنة احدى عشر و
                        الف</colophon>
                     <listBibl>
                        <bibl>
                           <ref
                              target="https://archive.org/stream/catalogueofpersi01bodluoft#page/416/mode/2up"
                              >Ethé 1350</ref>
                        </bibl>
                     </listBibl>
                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>
                  <msItem xml:id="MS_Fraser_168-item7" n="7">
                     <locus from="155" to="176">ff. 155b-176b</locus>
                     <author key="person_1152820116900682069" change="#ids-cleanup">
                        <persName xml:lang="fa-Latn-x-lc">Jalāl al-Dīn Muḥammad Munajjim
                           Yazdī</persName>
                        <persName xml:lang="fa">جلال الدين محمّد منجّم يزدى</persName>
                     </author>
                     <title xml:lang="fa-Latn-x-lc" key="">Khulāṣat al-raml</title>
                     <title xml:lang="fa" key="">خلاصة الرمل</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم حمد بيعد خالقى را كه حمرۀ شفق كه
                        منسوب باجتماع نور عشق است</incipit>
                     <explicit xml:lang="fa" defective="true">باد و باران تنك و ابر بيره و منقطع و
                        حين طلوع آفتاب و نصف النهار</explicit>
                     <textLang mainLang="fa">Persian</textLang>
                     <listBibl>
                        <bibl>
                           <ref
                              target="https://archive.org/stream/catalogueofpersi01bodluoft#page/462/mode/2up"
                              >Ethé 1501</ref>
                        </bibl>
                     </listBibl>
                  </msItem>
               </msContents>


                     Astronomy </summary>

                  <msItem xml:id="MS_Arch_Seld_A_46-item1" n="1" class="#translation">
                     <locus from="1" to="10">ff. 1v-10v</locus>
                     <author key="person_12392936" ref="http://www.viaf.org/viaf/12392936/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Ṭūsī, Naṣīr al-Dīn
                           Muḥammad ibn Muḥammad, <date calendar="#Gregorian" from="1201"
                              to="1274">1201-1274</date>
                        </persName>
                        <persName xml:lang="ar">نصير الدين الطوسي، محمد بن محمد،597-672
                           هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_4472">Kitāb al-Muʻṭayāt</title>
                     <title xml:lang="ar" key="work_4472">كتاب المعطيات</title>
                     <note>The <title>Data</title> of <persName key="person_176184097"
                           ref="http://viaf.org/viaf/176184097/" type="standard" role="ant"
                           change="#role-assignment #ids-cleanup">Euclid</persName>
                        <persName xml:lang="ar">إقليدس</persName>, translated by <persName
                           type="standard" xml:lang="ar-Latn-x-lc" key="person_81962417"
                           ref="http://viaf.org/viaf/81962417" role="trl" change="#role-assignment"
                           >Isḥāq ibn Ḥunayn, <date calendar="#Gregorian" from="0830" to="0911"
                              >830 or 31-910 or 11</date>
                        </persName>
                        <persName xml:lang="ar">ابن حنين، إسحاق، 215-298 هـ</persName>and revised by
                           <persName type="standard" xml:lang="ar-Latn-x-lc" key="person_55563658"
                           ref="http://viaf.org/viaf/55563658/" role="edt" change="#role-assignment"
                           >Thābit ibn Qurrah al-Ḥarrānī, d. <date calendar="#Gregorian"
                              when="0901">901</date>
                        </persName>
                        <persName xml:lang="ar">ثابت بن قرة، 211-288 هـ</persName>
                     </note>
                     <note>Hyderabad edition, vol. I, no. I</note>
                     <incipit xml:lang="ar">
                        بسم الله الرحمن الرحيم وبه نستعين قال ضاعف الله جلاله
                        هذا تحرير كتاب المعطيات لاقليدس  ترجمه
                        اصلحه ثابت وهو خمسة وسبعون شكلا الخطوط
                        والسطوح والزوايا المعلومة القدر هي التي يمكن ان تجد مساوية
                     </incipit>
                   <colophon xml:lang="ar"> تم كتاب المعطيات ولله الحمد والمنة في التاريخ سنة ٦
                        خمسين و ٨٠٠ </colophon>
                     <explicit xml:lang="ar"> فنقطة د معلومة والدائرة معلومة الوضع وقد مر فيها ا ح
                        بنقطة د المعلومة فسطح اد في د ح اعنى سطح ا د ك ه د معلوم وذلك ما اردناه </explicit>
                     <listBibl>
                        <bibl>GAL I 511</bibl>
                        <bibl>UAM 895(1) with corrig. Nicoll p. 599</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arch_Seld_A_46-item2" n="2">
                     <locus from="11" to="14">ff. 11v-14r</locus>
                     <author key="person_12392936" ref="http://www.viaf.org/viaf/12392936/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Ṭūsī, Naṣīr al-Dīn
                           Muḥammad ibn Muḥammad, <date calendar="#Gregorian" from="1201"
                              to="1274">1201-1274</date>
                        </persName>
                        <persName xml:lang="ar">نصير الدين الطوسي، محمد بن محمد،597-672
                           هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_4473">Kitāb al-Mafrūḍāt</title>
                     <title xml:lang="ar" key="work_4473">كتاب المعروضات لثابت بن قرّة</title>
                     <note>Of <persName type="standard" xml:lang="ar-Latn-x-lc"
                           key="person_55563658" ref="http://viaf.org/viaf/55563658/" role="edt"
                           change="#role-assignment">Thābit ibn Qurrah al-Ḥarrānī, d. <date
                              calendar="#Gregorian" when="0901">901</date>
                        </persName>
                        <persName xml:lang="ar">ثابت بن قرة، 211-288 هـ</persName>
                     </note>
                     <note>Hyderabad edition, vol. II no. 2</note>
                     <incipit xml:lang="ar"> بسم الله الرحمن الرحيم تحرير كتاب المعروضات لثابت بن
                        قرة الحراني وفي ستة وثلثون شكلا وفي بعض النسخ اربعة وثمنون شكلا على الترتيب
                        المثبت بالارقام السود على الجانب </incipit>
                     <colophon xml:lang="ar"> ووقع الفراغ من استنساخه بعون الله اللطيف على يدي
                        الفقير سيد بن احمد بن عطاالله في الشهر المبارك ذي القعدة سنة ستة وخمسين
                        وثمانمائة </colophon>
                     <explicit xml:lang="ar">وكان ا د معلوما فكل واحد من ا ه ه د اعنى ه ج معلوم
                        وجميع اج معلوم وذلك ما اردناه تم كتاب المفروضات والحمد الله اولا واخرا
                        وصلواته على محمد عبده ورسوله النبي الامي وعلى آله الطاهرين وسلامه </explicit>
                     <listBibl>
                        <bibl>GAL I 511</bibl>
                        <bibl>UAM 895(10)</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arch_Seld_A_46-item3" n="3" class="#translation">
                     <locus from="15" to="15">fol. 15r</locus>
                     <author key="person_12392936" ref="http://www.viaf.org/viaf/12392936/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Ṭūsī, Naṣīr al-Dīn
                           Muḥammad ibn Muḥammad, <date calendar="#Gregorian" from="1201"
                              to="1274">1201-1274</date>
                        </persName>
                        <persName xml:lang="ar">نصير الدين الطوسي، محمد بن محمد،597-672
                           هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_4474">Kitāb al-Masākīn</title>
                     <title xml:lang="ar" key="work_4474">كتاب المساكن</title>
                     <note>Of <persName key="person_25377100" role="ant"
                           change="#role-assignment #ids-cleanup">Theodosius</persName>
                        <persName xml:lang="ar">ثاودوسيوس</persName>, translated by <persName
                           type="standard" xml:lang="ar-Latn-x-lc" key="person_36906875"
                           ref="http://www.viaf.org/viaf/36906875/" role="trl"
                           change="#role-assignment">Qusṭā ibn Lūqā, <date calendar="#Gregorian"
                              from="0820" to="0912" cert="unknown">ca. 820-ca. 912</date>
                        </persName>
                        <persName xml:lang="ar" key="person_36906875"
                           ref="http://www.viaf.org/viaf/36906875/" role="trl"
                           change="#role-assignment">قسطا بن لوقا البعلبكي، ت. حو. 300 هـ</persName>
                     </note>
                     <note>Hyderabad edition, vol. I, no. 4</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وبه نستعين قال ضاعف الله جلاله
                        هذا التحرير كتاب المساكن لثاودوسيوس وهو اثنا عشر شكلا نقل قسطا لوقا البعلبكي
                        الذي مسكنهم تحت القطب الشمالي فنصف الكرة الكل الظاهر لهم هو ابدا ظاهر لهم </incipit>
                     <explicit xml:lang="ar"> الذين مساكنهم تحت مدار بعده عن القطب الظاهر مساويا
                        للميل كله نسبة بروج مما يطلع عليهم وتغيب عنهم فليكن نصف النهار </explicit>
                     <listBibl>
                        <bibl>GAL I 512</bibl>
                        <bibl>UAM 895(11)</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arch_Seld_A_46-item4" n="4" class="#translation">
                     <locus from="15" to="21">fol. 15r-21v</locus>
                     <author key="person_12392936" ref="http://www.viaf.org/viaf/12392936/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Ṭūsī, Naṣīr al-Dīn
                           Muḥammad ibn Muḥammad, <date calendar="#Gregorian" from="1201"
                              to="1274">1201-1274</date>
                        </persName>
                        <persName xml:lang="ar">نصير الدين الطوسي، محمد بن محمد،597-672
                           هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_4475">Kitāb fī al-ṭulūʻ
                        wa-al-ghurūb</title>
                     <title xml:lang="ar" key="work_4475">كتاب في الطلوع والغروب</title>
                     <note>Of <persName key="person_100218815" role="ant"
                           change="#role-assignment #ids-cleanup">Autolycus</persName>
                        <persName xml:lang="ar">أوطولوقس</persName>, translated by <persName
                           type="standard" xml:lang="ar-Latn-x-lc" key="person_55563658"
                           ref="http://viaf.org/viaf/55563658/" role="trl" change="#role-assignment"
                           >Thābit ibn Qurrah al-Ḥarrānī, d. <date calendar="#Gregorian"
                              when="0901">901</date>
                        </persName>
                        <persName xml:lang="ar">ثابت بن قرة، 211-288 هـ</persName>
                     </note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وبه نستعين المقالة الاولى ىه شكلا
                        كتاب اوطولوقس في الطلوع والغروب من اصلاح ثابت وهو مقالتان المقالة الاولى له
                        شكلا المقالة الثانية كا شكلا صدر يقال لبعض طلوعات الكواكب وغروباتها وخصوصا
                        الثوابت انها خفية ولبعضها انها ظاهرة </incipit>
                     <explicit xml:lang="ar"> ومعه ه ا اخر غروبه المسائي ويكون كل واحد في قوس م د ك
                        ح ل خمسة بروج وقوس ل ج م و في قوس الحماء اعظم من برجين بعدد قوس ك ق وذلك ما
                        اردناه تمت المقالة الثامنة والحمد الله حق حمده وصلواته على خير خلقه سيدنا
                        محمد النبي واله وصحبه وسلم تسلما كثيرا </explicit>
                     <colophon xml:lang="ar">في ليلة الثالثة والعشرين من شهر شوال سنة وخمسين
                        وثمانمائه الهجريه المصطفويه اللهم اغفر لكاتبه وقارئه ولمن دعا لكاتبه
                        ولوالديه واسلافه واساتذته وتلاميذه ولجميع المؤمنين اجمعيا </colophon>
                     <listBibl>
                        <bibl>GAL I 512</bibl>
                        <bibl>UAM 895(2)</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Arch_Seld_A_46-item5" n="5">

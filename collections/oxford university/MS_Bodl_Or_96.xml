               <msContents>
                  <summary change="#add-summary"> 1 copy of al-Tabṣirah fī ʻilm al-hayʼah by
                     Kharaqī, ʻAbd al-Jabbār ibn ʻAbd al-Jabbār, 1084-1158 </summary>
                  <msItem xml:id="MS_Bodl_Or_96-item1">
                     <author key="person_90056192" ref="http://www.viaf.org/viaf/90056192/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Kharaqī, ʻAbd al-Jabbār
                           ibn ʻAbd al-Jabbār, <date calendar="#Gregorian" from="1084" to="1158"
                              >1084-1158</date>
                        </persName>
                        <persName xml:lang="ar">الخرقي، عبد الجبار بن عبد الجبار، 477-553
                           هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_3489">al-Tabṣirah fī ʻilm
                        al-hayʼah</title>
                     <title xml:lang="ar" key="work_3489">التبصرة في علم الهيئة</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وبه نستعين الحمد لله حق حمده
                        والصلوة على خير خلقه محمد [...] وألفت هذا الكتاب في علم الهيئة أعني معرفة
                        أشكال الأفلاك وحركاتها وأحوال الكواكب فيها </incipit>
                     <explicit xml:lang="ar">كل ساعة من الساعات ستين دقيقة على ما جرت به عادتهم في
                        قسمة الدرج وأجزائها بالأجزاء الستينية والله تعالى أعلم</explicit>
                     <colophon xml:lang="ar">تم الكتاب على يد العبد المذنب الفقير إلى رحمة الله
                        تعالى وغفرانه ياقوت ارسلان المنجم بن أبى الحسن بن الحسن الخلاطي في حادي
                        وعشرين ذو القعدة سنة اثني وثلثين وستمائة هجرية على صاحبها أفضل الصلوة
                        والتسليم حامداً لله على نعمه ومصلياً على نبيه محمد وآله أجمعين بميا فارفين
                        المحروسة والحمد لله رب العالمين وصلى الله على سيدنا محمد وعلى آله وأصحابه
                        الطاهرين وحسبنا الله ونعم الوكيل</colophon>
                     <listBibl>
                        <bibl>GAL I 473</bibl>
                        <bibl>[UAM. 976, with corrig. Nicoll p. 604; revd. by Beeston]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

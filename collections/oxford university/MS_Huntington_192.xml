               <msContents class="#multipleWorks">
                  <summary change="#add-summary2"> 13 works by 11 authors on the subjects of
                     Astrology, Arabic alphabet, Mysticism, Nile River, Didactic poetry, Koran,
                     Arithmetic, Astronomical instruments, Mathematics, Astronomy, and Calendars </summary>
                  <msItem xml:id="MS_Huntington_192-item1" n="1" class="#commentary">
                     <locus from="1" to="77">ff. 1v-77r</locus>
                     <author key="person_90055769" change="#ids-cleanup">
                        <persName xml:lang="ar-Latn-x-lc">Ibn Qunfūdh, Abū al-ʻAbbās Aḥmad ibn
                           al-Khaṭīb d. 1407</persName>
                        <persName xml:lang="ar">ابن قنفذ، أحمد بن حسين، 740-810 هـ</persName>
                     </author>
                     <title key="work_5093">Commentary on the <title xml:lang="ar-Latn-x-lc"
                           >Manẓūmah fī ʻilm al-nujūm</title> of <persName type="standard"
                           xml:lang="ar-Latn-x-lc" key="person_311112773"
                           ref="http://viaf.org/viaf/311112773/" role="ant"
                           change="#role-assignment #ids-cleanup">Ibn Abī al-Rijāl, ʻAlī, <date
                              calendar="#Gregorian" from="1015" to="1063">1015 or 16-1062 or
                              3</date>
                           <title xml:lang="ar" key="work_5093">شرح منظومة ابن أبي الرجال في علم
                              النجوم</title>
                        </persName>
                     </title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وصلى الله على سيدنا محمد وآله
                        وسلم. الحمد لله الذي خلق الخلق بقدرته وميزهم بحكمته وكون الأشياء فأحسن
                        كونها... وبعد فإني لما رأيت أرجوزة الفاضل أبي الحسن علي بن أبي الرجال الكاتب
                        القيرواني حاصرة لأكثر القواعد في القضايا النجومية </incipit>
                     <explicit xml:lang="ar">قال بعض العلماء ما أصعب منحسة المريخ إذا جاسد عطارد
                        ويدل أيضاً على الصواعق والبرد لأن الكاتب ممتزج فإذا قارن النحس قويت دلالته
                        وهاهنا انتهى غرضي في هذا المجموع المبارك ... ولاحول ولا قوة إلا بالله العلي
                        العظيم والحمد لله رب العالمين</explicit>
                     <colophon xml:lang="ar">تم كتاب شرح قصيدة اين أبي الرجال للفقيه المرحوم سيدي
                        أحمد بن الخطيب القسنطيني رحمه الله تعالى وكات الفراغ على يد كاتبه الفقير
                        محمد ابن أحمد المسلمي المجطمري يوم الثلاثاء المبارك افتتاح شهر محرم الحرام
                        سنة اثنين وخمسين وألف من الهجرة النبوية على صاحبها أفضل الصلاو والسلام
                        والحمد لله وحده</colophon>
                     <note>*In footnote 'e' to Nicollʼs entry following, Marsh 192 is a mistake for
                        Hunt.</note>
                     <listBibl>
                        <bibl>GAL I 224</bibl>
                        <bibl>[UAM. 971 (1), with corrig. Nicoll p. 604]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item2" n="2">
                     <locus from="81" to="101">ff. 81v-101v</locus>
                     <author key="person_f4203">
                        <persName xml:lang="ar-Latn-x-lc">Tamarbāī, Shihāb al-Dīn Aḥmad</persName>
                        <persName xml:lang="ar">تمرباي، شهاب الدين أحمد</persName>
                     </author>
                     <note>The author is said to have lived during the Mamlūk era.</note>
                     <title xml:lang="ar-Latn-x-lc" key="work_5187">al-Natāʼij al-tajrībīyah ʻan
                        al-muqaddimāt al-falakīyah</title>
                     <title xml:lang="ar" key="work_5187">النتائج التجريبية عن المقدّمات
                        الفلكية</title>
                     <incipit xml:lang="ar">بسم الله الرحمٰن الرحيم رب يسر ولا تعسر يا كريم. حمداً
                        .لله على نعمائه. وصلاة وسلاماً على أفضل أنبيائه. وعلى آله وأصحابه وأصفيائه
                        وبعد فيقول الشيخ الإمام العلامةالجناب الشهابي أحمد بن الجناب الشهاب تمرباي
                        الحنفي اعلم أرشدك الله أن معرفة الأحداث السفلية من دلالات الأشخاص العلوية
                        تستنبط من وجوه كثيرة</incipit>
                     <explicit xml:lang="ar">وربّما فسد أمر الملك وأمر الرعية معاً من أمر عظيم يظهر
                        وتكثر الفتن وأكثر ذلك في قسمة البرج الذي يكونان فيه والله أعلم بالصواب وإليه
                        المرجع والمآب</explicit>
                     <colophon xml:lang="ar">تمت بحمد الله وعونه وحسن توفيقه وصلى الله على سيدنا
                        محمد وعلى آله وصحبه وسلم تسليماً كثيراً</colophon>
                     <listBibl>
                        <bibl>Appendix Astrology</bibl>
                        <bibl>[UAM. 971 (2), with corrig. Nicoll p. 604.]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item3" n="3">
                     <locus from="102" to="107">ff. 102v-107r</locus>
                     <author key="person_f1727">
                        <persName xml:lang="ar-Latn-x-lc">Jawharī, ʻAbd al-Raḥmān ibn Muḥammad
                           al-Ṣāliḥī</persName>
                        <persName xml:lang="ar">الجوهري، عبد الرحمن بن محمد الصالحي</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5188">Risālah al-iksīr fī al-basṭ
                        wa-al-taksīr</title>
                     <title xml:lang="ar" key="work_5188">رسالة الإكسير في البسط والتكسير</title>
                     <note>On the mystical properties of the Arabic alphabet*</note>
                     <note>*So Uri; Brock. "ūber den Stein der Weisen"</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم اللهم لا سهل إلا ما جعلته سهلاً
                        الحمد لله الذي علم الإنسان ما لم يعلم وأوجدنا من العدم... وبعد فهذه رسالة
                        ظريفة وفوائدها لطيفة تبدى لناشق طيب أنفاسها مسكاً أزفراً </incipit>
                     <explicit xml:lang="ar">فإن كثرت عليك أعدادها فاجعلها مطروحة بالجمّل الصغير ثم
                        يحمله الطالب فيشاهد العجائب وليكن هذا آخر الكتاب</explicit>
                     <listBibl>
                        <bibl>Supp. II. Anhang, p. 1034</bibl>
                        <bibl>[UAM. 971 (3)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item4" n="4">
                     <locus from="108" to="110">ff. 108v-110r</locus>
                     <author key="person_68748640" ref="http://viaf.org/viaf/68748640/">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Wafāʼī, ʻAbd al-ʻAzīz
                           ibn Muḥammad, <date calendar="#Gregorian" notBefore="1400"
                              notAfter="1500">15th cent.</date>
                        </persName>
                        <persName xml:lang="ar">وفائي، عبد العزيز بن محمد</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5189">Fāʼidah jalīlah fī maʻrifat ḥāl
                        al-Nīl wa-mablaghihi</title>
                     <title xml:lang="ar" key="work_5189">فائدة جليلة في معرفة حال النيل
                        ومبلغه</title>
                     <note>Copied from the autograph</note>
                     <incipit xml:lang="ar">في كل سنة اطرح درج مقوم القمر ودقائقه فقط للزوال الأقرب
                        ليوم انتقال الشمس إلى الحمل</incipit>
                     <listBibl>
                        <bibl>GAL II 129</bibl>
                        <bibl>[UAM. 971 (4), with corrig. Nicoll p. 604]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item5" n="5">
                     <locus from="112" to="121">ff. 112v-121v</locus>
                     <author key="person_f551">
                        <persName xml:lang="ar-Latn-x-lc">Aḥmad ibn Shaykh al-Islām al-ʻĀrif
                           bi-Allāh ʻUthmān al-ʻIzzī al-Mālikī</persName>
                        <persName xml:lang="ar">أحمد بن شيخ الإسلام العارف بالله عثمان العزّي
                           المالكي</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5190">al-Manẓūmah al-lāmīyah fī
                        al-qirāʼāt al-ʻashr</title>
                     <title xml:lang="ar" key="work_5190">المنظومة اللامية في القراءات العشر</title>
                     <note>A poem on the ten schools of Qurʼān recitation</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وبه ثقتي. لك الحمد ما تالي كتابك
                        قد تلا || وأزكى صلاة مع سلام لقد تلا</incipit>
                     <explicit xml:lang="ar">وقل بنظامي جا تاريخ نظمها || قول لها عداضاً
                        مكملاً</explicit>
                     <listBibl>
                        <bibl>Appendix Qurʼān; Recitation</bibl>
                        <bibl>[UAM. 971 (5), with corrig. Nicoll p. 604]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item6" n="6">
                     <locus from="122" to="131">ff. 122v-131r</locus>
                     <author key="person_56587788" ref="http://www.viaf.org/viaf/56587788/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Ibn al-Hāʼim, Aḥmad ibn
                           Muḥammad, d. <date calendar="#Gregorian" when="1412">1412</date>
                        </persName>
                        <persName xml:lang="ar">ابن الهائم، أحمد بن محمد، 753-815 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5191">al-Lumaʻ al-yasīrah fī ʻilm
                        al-ḥisāb</title>
                     <title xml:lang="ar" key="work_5191">اللمع اليسيرة في علم الحساب</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم قال الشيخ الإمام...أحمد بن محمد
                        بن علي بن عماد الشهير والده الهائم...أما بعد فهذه لمع يسيرة في علم الحساب
                        يضطر إلى معرفتها من يريد الشروع في الفرائض</incipit>
                     <explicit xml:lang="ar">وإن علس فالجواب سبع وهذا آخر ما أردنا بيانه تسهيلاً على
                        المبتدئين والحمد لله رب العالمين</explicit>
                     <colophon xml:lang="ar">علقه لنفسه ثم لمن يشاء الله من بعده العبد صليب البويني
                        في شهر شعبان سنة ١٠١٥</colophon>
                     <listBibl>
                        <bibl>GAL II 125</bibl>
                        <bibl>[UAM. 971 (6)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item7" n="7" class="#abridgement">
                     <locus from="132" to="141">fols. 132r-141v</locus>
                     <author key="person_56597947" ref="http://www.viaf.org/viaf/56597947/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Sibṭ al-Māridīnī, Badr
                           al-Dīn Muḥammad ibn Muḥammad, b. <date calendar="#Gregorian"
                              when="1423">1423</date>
                        </persName>
                        <persName xml:lang="ar">سبط المارديني، محمد بن محمد، 826-912 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_4918" change="#ids-cleanup">Kifāyat
                        al-qunūʻ fī al-ʻamal bil-rubʻ al-maqṭūʻ</title>
                     <title xml:lang="ar" key="work_4918">كفاية القنوع في العمل بالربع
                        المقطوع</title>
                     <note>An abridgment of his <title xml:lang="ar-Latn-x-lc" key="">Iẓhār al-sirr
                           al-mawḍūʻ fī al-ʻamal bil-rubʻ al-maqṭūʻ</title><title xml:lang="ar"
                           >إظهار السرّ الموضوع في العمل بالربع المقطوع</title>
                     </note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم اللهم صل وسلم على سيدنا محمد وآله
                        قال شيخنا وسيدنا ... بدر الدين محمد بن محمد ابن أحمد المارديني الشافعي ...
                        وبعد فهذه رسالة مختصرة في العمل بالربع الشمالي المقطوع</incipit>
                     <explicit xml:lang="ar">ثم اسقط من الجملة يفضل المطلوب وكذا تفعل بمطالع طلوعه
                        ومطالع مغيبه والله أعلم وصلى الله على محمد وآله وصحبه وسلم</explicit>
                     <colophon xml:lang="ar">تم بحمد الله كتبه لنفسه مسلم بن أحمد بن العارف بالله
                        تعالى الشيخ أحمد الصطيحه بتاريخ يوم الأربعاء ثاني عشر ذي الحجة الحرام من سنة
                        أربع بعد الألف</colophon>
                     <listBibl>
                        <bibl>GAL II 168</bibl>
                        <bibl>[UAM. 971 (7)</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item8" n="8">
                     <locus from="142" to="145">ff. 142v-145v</locus>
                     <author key="person_68748640" ref="http://viaf.org/viaf/68748640/">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Wafāʼī, ʻAbd al-ʻAzīz
                           ibn Muḥammad, <date calendar="#Gregorian" notBefore="1400"
                              notAfter="1500">15th cent.</date>
                        </persName>
                        <persName xml:lang="ar">الوفائي، عبد العزيز ين محمد</persName>
                     </author>
                     <title key="work_5193">Risālah al-muthallath wa-huwa suds al-dāʼirah
                        al-jaybīyah</title>
                     <title xml:lang="ar" key="work_5193">رسالة المثلّث وهو سدس الدائرة
                        الجيبية</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم أما بعد حمد الله والصلاة على رسول
                        الله محمد بن عبد الله صلى الله عليه وسلم فقد سألني بعض الإخوان في عمل رسالة
                        على المثلث فأجبته إلى سؤاله معترفاً بالعجز والتقصير</incipit>
                     <listBibl>
                        <bibl>GAL II 129</bibl>
                        <bibl>[UAM. 971 (8), with corrig. Nicoll p. 604]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item9" n="9">
                     <locus from="150" to="162">ff. 150v-162v</locus>
                     <author key="person_f1372">
                        <persName xml:lang="ar-Latn-x-lc">Ibn Abī Shukr, Yaḥyá ibn Muḥammad
                           al-Maghribī al-Andalusī</persName>
                        <persName xml:lang="ar">يحيى بن محمد بن أبي شكر المغربي الأندلسي</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5194">Risālah al-Khiṭāʼ
                        wa-al-Īghur</title>
                     <title xml:lang="ar" key="work_5194">رسالة الخطاء والإيغر</title>
                     <note>really an extract (bāb 13), on the Chinese and Uighur calendars, taken
                        from a longer work.</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم قال الشيخ الإمام العالم العلامة
                        فريد الدهر ووحيد العصر سيد المهندسين محيي الحق والدين يحيى بن محمد بن أبي
                        الشكر المغربي الأندلسي قدس الله روحه ونور ضريحه الباب ١٣ في معرفة مداخل سني
                        الخطاء والإيغر وشهورهما والماضي من سني العالم على مذهب الخطاء</incipit>
                     <explicit xml:lang="ar">فإذل قسمنا المدة على ألف تحصل زمان الدور ٤٣٢٥٥٥٥ وخمساه
                        أعني زمان الفصل ١٧٢٨٥٥٥ والله أعلم بالصواب والحمد لله وحده تم تم تم تم تم
                        تم</explicit>
                     <listBibl>
                        <bibl>GAL I 474</bibl>
                        <bibl>[UAM. 971 (9)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item10" n="10">
                     <locus from="168" to="185">ff. 168v-185r</locus>
                     <author key="person_68748640" ref="http://viaf.org/viaf/68748640/">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Wafāʼī, ʻAbd al-ʻAzīz
                           ibn Muḥammad, <date calendar="#Gregorian" notBefore="1400"
                              notAfter="1500">15th cent.</date>
                        </persName>
                        <persName xml:lang="ar">الوفائي، عبد العزيز ين محمد</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5195">Nuzhat al-naẓar fī al-ʻamal
                        bil-shams wa-al-qamar</title>
                     <title xml:lang="ar" key="work_5195">نزهة النظر في العمل بالشمس والقمر</title>
                     <incipit xml:lang="ar">في الباب الثالث والخمسين من كتاب الأزمنة لأبي على
                        المرزوقي ما نصه اعلم أن الشهر إذا تم كان ثلاثين يوماً</incipit>
                     <listBibl>
                        <bibl>GAL II 129</bibl>
                        <bibl>[UAM. 971 (10), with corrig. Nicoll p. 604.]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item11" n="11">
                     <locus from="188" to="197">ff. 188r-197v</locus>
                     <author key="person_f4261">
                        <persName xml:lang="ar-Latn-x-lc">Tājūrī, Abū Zaid ʻAbd al-Raḥmān, <date
                              calendar="#Gregorian" when="1590">d. 1590</date>
                        </persName>
                        <persName xml:lang="ar">تاجوري، أبو زيد عبد الرحمن</persName>
                     </author>
                     <title xml:lang="la" key="work_5196">"De temporum cognoscendorum ratione
                        Tractatus"</title>
                     <title xml:lang="ar-Latn-x-lc" key="work_5196">Muqaddimah fī al-fuṣūl
                        al-arbaʻah</title>
                     <title xml:lang="ar-Latn-x-lc" type="alt" key="work_5196">Risālah fī al-fuṣūl
                        al-arbaʻah</title>
                     <title xml:lang="ar" key="work_5196">رسالة في الفصول الأربعة</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم اللهم صل وسلم على سيدنا محمد وآله
                        وصحبه وسلم وبعد فهذه مقدمة مختصرة تعلم منها الفصول الأربعة</incipit>
                     <explicit xml:lang="ar">كذلك في البحر إلى جدة وأهل جدة يصلون إلى المشرق والله
                        أعلم</explicit>
                     <colophon xml:lang="ar">اللهم صل وسلم على محمد وآله وصحبه وسلم كتبه لنفسه مسلم
                        بن أحمد بتاريخ يوم الجمعة سلخ جمادى الأول سنة ٩٩٥</colophon>
                     <listBibl>
                        <bibl>GAL II 358</bibl>
                        <bibl>[UAM. 971 (11)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item12" n="12">
                     <locus from="198" to="205">ff. 198r-205v</locus>
                     <author key="person_103769699" change="#ids-cleanup">
                        <persName xml:lang="ar-Latn-x-lc">Urmayūnī, Shams al-Dīn Muḥammad ibn Abī
                           al-Khayr, al-Ḥasanī al-Ṭaḥḥān <date calendar="#Gregorian"
                              notBefore="1500" notAfter="1600">16th cent.</date>
                        </persName>
                        <persName xml:lang="ar">الأرميوني، شمس الدين محمد بن ابي الخير الحسني
                           الطحّان</persName>
                     </author>
                     <title key="work_5197">Exposition of the Christian Easter, with tables</title>
                     <title xml:lang="ar-Latn-x-lc" key="work_5197">Kitāb al-Tanqīḥ fī taḥrīr Fiṣḥ
                        al-Masīh</title>
                     <title xml:lang="ar" key="work_5197">كتاب التنقيح في تحرير فصح المسيح</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم حمداً لك اللهم يا من تفرد
                        بالإبداع والاختراع والخلق والإيجاد...وبعد فلما كان علم التقاويم والزيجات بعد
                        العلوم الشرعية في أرفع الدرجات</incipit>
                     <explicit xml:lang="ar">وليكن هذا آخر الفصل وبتمامه تمت الرسالة والله
                        أعلم</explicit>
                     <colophon xml:lang="ar">انتهت على يد العبد الفقير الراجي عفو ربه القدير علي
                        الميقاتي الحنفي تلميذ المرحوم الشيخ العلامة عبد الرحمن الطناني الموقت
                        بالجامع الأزهر رحمه الله رحمة واسعة</colophon>
                     <listBibl>
                        <bibl>GAL II 358</bibl>
                        <bibl>[UAM. 971 (12)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Huntington_192-item13" n="13">
                     <locus from="206" to="211">ff. 206v-211r</locus>
                     <author key="person_4150262695905720228" change="#ids-cleanup">
                        <persName xml:lang="ar-Latn-x-lc">Qabbānī*, Khiḍr ibn ʻAbd al-Qādir,
                           al-Burullusī</persName>
                        <persName xml:lang="ar">القبّاني، خضر بن عبد القادر البرلسي</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5198">Irshād al-ḥayārá fī maʻrifat
                        istikhrāj ʻīd al-naṣārá</title>
                     <title xml:lang="ar" key="work_5198">إرشاد الحيارى في معرفة استخراج عيد
                        النصارى</title>
                     <note>On calculating Christian festivals</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم الحمد لله الذي نور قلوب علمائه
                        بالعلم والإيمان وجوهر عقول أهل التصائر بالقضل والعرفان...وبعد فيقول فقير
                        رحمة ربه...لما أن خصل الخلف بين كائفة النصارى اليعقوبية وبين أبناء جنسهم من
                        بني النصرانية</incipit>
                     <explicit xml:lang="ar">وما يقابل العدد المطلوب تحت الفسح العرضي هو الفسح
                        المسيحي والله أعلم</explicit>
                     <colophon xml:lang="ar">كتبه علي الأحمدي الميقاتي الحنفي غفر الله
                        ذنوبه</colophon>
                     <note>*Said by Pusey to be in H. Khaf. "alicubi"</note>
                     <listBibl>
                        <bibl>Appendix Calendar</bibl>
                        <bibl>[UAM. 971 (13), with corrig. Nicoll p. 604]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

               <msContents class="#multipleWorks">
                  <summary change="#add-summary2"> 8 works by 5 authors on the subjects of
                     Arithmetic, Astronomy, and Logic </summary>
                  <msItem xml:id="MS_Bodl_Or_208-item1" n="1">
                     <locus from="1" to="11">ff. 1v-11r</locus>
                     <author key="person_f407">Anonymous</author>
                     <title key="work_6470">A treatise on arithmetic</title>
                     <note>In a <foreign xml:lang="ar-Latn-x-lc">muqaddimah</foreign> 50 <foreign
                           xml:lang="ar-Latn-x-lc">maqālah</foreign> s and a <foreign
                           xml:lang="ar-Latn-x-lc">khātimah</foreign> [fragment only, the earlier
                        part]</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم وبه نستعين الحمد للأول بلا عدد
                        والآخر بلا مدد صاحب القدرة القاهرة والحكمة الباهرة الذي لا تدركه الحواس ولا
                        يطرد فيه القياس لا تبلغه ثواقب الافهام ولا تلحقه صوايب الأوهام</incipit>
                     <explicit xml:lang="ar">فان طلبت نصف أكثر من واحد او اقل منه ضربت المطلوب بنصفه
                        في المقسوم وقسمت الحاصل على المقسوم عليه يكون جوابا ولو قسمت المقسوم على
                        المقسوم عليه</explicit>
                     <listBibl>
                        <bibl>Appendix Mathematics</bibl>
                        <bibl>[NAM. 291 (1)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>
                  <msItem xml:id="MS_Bodl_Or_208-item2" n="2" class="#commentary">
                     <locus from="16" to="21">ff. 16v-21r</locus>
                     <author key="person_19930855">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Jurjānī, ʻAlī ibn
                           Muḥammad, al-Sayyid al-Sharīf, 1340-1413</persName>
                        <persName xml:lang="ar">الجرجاني، علي بن محمد، 740-816 هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_2417">Risālah fī al-wujūd</title>
                     <title xml:lang="ar" key="work_2417">رسالة في الوجود</title>
                     <note>The list of contents of this manuscript identify this only as <foreign
                           xml:lang="fa">رساله فارسيه</foreign></note>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم وبه نستعين بدانكه وفقك الله
                        وايانا كه اصحاب بحث و نظر از براى مراتب موجودات در موجوديت تمثيلى كرده‌اند و
                        چنین گفته‌اند که اشیاء نورانى را در نورانيت سه مرتبه است</incipit>
                     <explicit xml:lang="fa">و شک نیست که ناقصى خداى را نشاید پس بیزاری ایشان از خدا
                        نباشد و کفر هیچ كدام لازم نیاید</explicit>
                     <textLang mainLang="fa">Persian</textLang>
                     <listBibl>
                        <bibl/>
                     </listBibl>

                  </msItem>
                  <msItem xml:id="MS_Bodl_Or_208-item3" n="3" class="#commentary">
                     <locus from="24" to="86">ff. 24v-86v</locus>
                     <author key="person_19930855">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Jurjānī, ʻAlī ibn
                           Muḥammad, al-Sayyid al-Sharīf, 1340-1413</persName>
                        <persName xml:lang="ar">الجرجاني، علي بن محمد، 740-816 هـ</persName>
                     </author>
                     <title key="" change="#ids-cleanup">Commentary on <title
                           xml:lang="ar-Latn-x-lc" ref="#m2" key="work_2801">al-Mulakhkhaṣ fī
                           al-hayʼah</title>
                        <title xml:lang="ar" key="work_2801">الملخص في الهيئة</title> of <persName
                           type="standard" xml:lang="ar-Latn-x-lc" key="person_5146153029805251752"
                           ref="http://www.viaf.org/viaf/5146153029805251752/" role="ant"
                           change="#role-assignment #ids-cleanup">Jighmīnī, Maḥmūd ibn
                           Muḥammad, d. <date calendar="#Gregorian" when="1221" cert="unknown"
                              >1221?</date>
                        </persName>
                        <persName xml:lang="ar" key="person_24458289"
                           ref="http://viaf.org/viaf/24458289"> الجغميني، محمود بن محمد، ت. 618؟
                           هـ</persName>
                     </title>
                     <title key="">شرح الملخص في الهيئة للسيد الشريف</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم سبحانك اللهم يا مدبر اطباق
                        السموات بلا عمد واوتاد على القطب المحور ويا مزين اجرام العلويات بالثوابت
                        والسيارات والنير الاعظم والاصغر</incipit>
                     <explicit xml:lang="ar">حتى إذا قابل القمر الشمس وصار البعد بينهما نصف الدور
                        صرنا نحن بين القمر والشمس وصار ما يواجه الشمس من القمر يواجها تم وبحمد لله
                        وحده</explicit>

                     <listBibl>
                        <bibl>GAL I 473</bibl>
                        <bibl>[NAM. 291 (3)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Bodl_Or_208-item4" n="4" class="#commentary">
                     <locus from="90" to="101">ff. 90v-101v</locus>
                     <author key="person_73701246" ref="http://www.viaf.org/viaf/73701246/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Qāḍīʹzādah, Mūsá ibn
                           Muḥammad, d. ca. <date calendar="#Gregorian" when="1436">1436</date>
                        </persName>
                        <persName xml:lang="ar">قاضي زاده، موسى جلبي بن محمد، ت. حو. 840
                           هـ.</persName>
                     </author>
                     <title key="work_371" change="#ids-cleanup">Commentary on <title
                           xml:lang="ar-Latn-x-lc" ref="#m2">al-Mulakhkhaṣ fī al-hayʼah</title>
                        <title xml:lang="ar">الملخص في الهيئة</title> of <persName type="standard"
                           xml:lang="ar-Latn-x-lc" key="person_5146153029805251752"
                           ref="http://www.viaf.org/viaf/5146153029805251752/" xml:id="m2"
                           role="ant" change="#role-assignment #ids-cleanup">Jighmīnī, Maḥmūd
                           ibn Muḥammad, d. <date calendar="#Gregorian" when="1221" cert="unknown"
                              >1221?</date>
                        </persName>
                        <persName xml:lang="ar" key="person_24458289"
                           ref="http://viaf.org/viaf/24458289"> الجغميني، محمود بن محمد، ت. 618؟
                           هـ</persName>
                     </title>
                     <note>Fragment only</note>
                     <incipit xml:lang="ar">الحمد لله الذي جعل الشمس ضياء والقمر نورا وبسط على بساط
                        البسيط ظلا وحرورا رفع خضراء ذات بروج وسراج وحوض غبراء ذات مروج وفجاج </incipit>
                     <explicit xml:lang="ar">لان الشمس اذا سامتها اعتدل الليل والنهار ىوىىا (؟) في
                        جميع النواحي الا في ءض تسعين اي استويا في المقدار والله أعلم</explicit>
                     <listBibl>
                        <bibl>GAL I 473</bibl>
                        <bibl>[NAM. 291 (4)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Bodl_Or_208-item5" n="5">
                     <locus from="106" to="125">ff. 106v-125v</locus>
                     <author key="person_f790">
                        <persName xml:lang="ar-Latn-x-lc">Būlī Beg</persName>
                        <persName xml:lang="ota">بولى بيك</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6471">Kitāb fī ʻilm al-falak</title>
                     <title xml:lang="ar" key="work_6471">كتاب في علم الفلك</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم الحمد لوليه والصلوة على نبيه وبعد
                        فان الرسالة مرتبة على مقدمة وعدة ابواب المقدمة في معرفة الرسوم ربع
                        الدايرة</incipit>
                     <explicit xml:lang="ar"> ولو استعملت خمسة وخمسة وعشرون وعشرة يخرج لك ما تريد
                        والله اعلم بالصواب وهو سريع الحساب </explicit>
                     <colophon xml:lang="ar"> وقع الفراغ من تنميقه بعون الله وحسن توفيقه في سنة ٩٢٢
                        في مصيف سلطانية في ناحية بروسه المحروسة </colophon>
                     <listBibl>
                        <bibl>Appendix Astronomy</bibl>
                        <bibl>[NAM. 291 (5)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Bodl_Or_208-item6" n="6">
                     <locus from="129" to="129">ff. 129</locus>
                     <author key="person_19930855" ref="http://www.viaf.org/viaf/19930855/">
                        <persName xml:lang="ar-Latn-x-lc" type="standard">Jurjānī, ʻAlī ibn
                           Muḥammad, al-Sayyid al-Sharīf, <date calendar="#Gregorian"
                              >1340-1413</date>
                        </persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_5888">Risālah lil-Sayyid al-Sharīf fī
                        ʻilm al-shayʼ bil-wajh</title>
                     <title xml:lang="ar" key="work_5888">رسالة للسيد الشريف في علم الشيء
                        بالوجه</title>
                     <note>Treatise on knowledge via a means or instrument, with regard to the image
                        in a mirror.</note>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم الناظر في المرآة ربما كان متوجهاً
                        إلى الصورة المرتسمة فيها ومشتغلا بها</incipit>
                     <explicit xml:lang="ar">فيستحيل أن يعلم الشيء بوجه واحد منفرداً عن علم آخر به
                        وهو بط اتفاقاً بل ضرورة تمت الرسالة للسيد الشريف رحمه الله</explicit>
                     <listBibl>
                        <bibl>Appendix Logic</bibl>
                        <bibl>GAL II 216-17</bibl>
                        <bibl>[NAM. 291 (6)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Bodl_Or_208-item7" n="7">
                     <locus from="129" to="133">fols. 129v-133v</locus>
                     <author key="person_4026337" ref="http://viaf.org/viaf/4026337/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Urmawī, Sirāj al-Dīn
                           Maḥmūd ibn Abī Bakr, <date calendar="#Gregorian" from="1198" to="1283"
                              >1198-1283</date>
                        </persName>
                        <persName xml:lang="ar">السراج الأرموي، محمود بن أبي بكر، 594-682
                           هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6473">Maṭāliʻ al-anwār fī
                        al-manṭiq</title>
                     <title xml:lang="ar">مطالع الأنوار في المنطق</title>
                     <incipit xml:lang="ar">بسم الله الرحمن الرحيم اللهم انا نحمدك، والحمد من آلائك
                        ،ونشكرك والشكر من نعمائك، ونسألك هدايا الهداية ونعوذ بك من الغباوة والغواية
                        ونبتغي منك اعلام الحق، والهام الصدق، فانه لا علم الا ما علمت، ولا دراية الا
                        ما ألهمت، انك انت الحكيم العليم، والجواد الكريم، ونبتهل اليك في ان نصلي على
                        محمد سيد المرسلين وخاتم النبيين، وعلى آله الطيبين الطاهرين وبعد</incipit>
                     <explicit xml:lang="ar">المعلوم وغير المعلوم بالتصور لم ينعكس عكس نقيض الأول
                        الموجب إلى منافى الثاني وجواب الشك أن المعلوم من وجه</explicit>
                     <listBibl>
                        <bibl>GAL I 467</bibl>
                        <bibl>[NAM. 291 (7)]</bibl>
                     </listBibl>
                     <textLang mainLang="ar">Arabic</textLang>
                  </msItem>

                  <msItem xml:id="MS_Bodl_Or_208-item8" n="8">
                     <locus from="136" to="156">fols. 136v-156v</locus>
                     <author key="person_4026337" ref="http://viaf.org/viaf/4026337/">
                        <persName type="standard" xml:lang="ar-Latn-x-lc">Urmawī, Sirāj al-Dīn
                           Maḥmūd ibn Abī Bakr, <date calendar="#Gregorian" from="1198" to="1283"
                              >1198-1283</date>
                        </persName>
                        <persName xml:lang="ar">السراج الأرموي، محمود بن أبي بكر، 594-682
                           هـ</persName>
                     </author>
                     <title xml:lang="ar-Latn-x-lc" key="work_6473">Maṭāliʻ al-anwār fī
                        al-manṭiq</title>
                     <title xml:lang="ar">مطالع الأنوار في المنطق</title>
                     <incipit xml:lang="fa">بسم الله الرحمن الرحيم چون عنایت ربانی حجاب انتظار از
                        پیش چهرهٔ مراد(؟) محرّران این سواد برداشت و سعادت خدمت پادشاه زلق ایران روزی
                        که وروز کار بانجاح مأمول و اسعاف مطلوب </incipit>
                     <explicit xml:lang="ar"> رساله معینیه والحمد لله اولا و آخرا و صلی الله علی
                        سیدنا محمد و آله اجمعین </explicit>
                     <textLang mainLang="fa">Persian</textLang>
                  </msItem>

               </msContents>
